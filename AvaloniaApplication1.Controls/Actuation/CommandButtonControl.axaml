<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApplication1.Controls.Actuation.CommandButtonControl"
             x:Name="Root"
             x:CompileBindings="False">
    <Button Command="{Binding #Root.Command}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Padding="2,1" MinHeight="14" MinWidth="14"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
            CornerRadius="5" Background="{Binding #Root.ButtonBackground}">
        <Grid RowDefinitions="Auto,*">
            <!-- Optional Title -->
            <Viewbox Grid.Row="0" MaxHeight="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="2,1"
                     IsVisible="{Binding #Root.ShowTitle}">
                <TextBlock Text="{Binding #Root.Title}" Foreground="#9E9E9E" FontSize="11" HorizontalAlignment="Center" />
            </Viewbox>

            <Grid Grid.Row="1">
                <!-- Standard (Non-ToggleSwitch) Button -->
                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2"
                         IsVisible="{Binding !#Root.IsToggleSwitchMode}">
                    <TextBlock Text="{Binding #Root.CurrentLabel}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" TextWrapping="Wrap" TextAlignment="Center" />
                </Viewbox>

                <!-- ToggleSwitch Multi-Style & Dual-Orientation -->
                <Grid IsVisible="{Binding #Root.IsToggleSwitchMode}" Margin="2">
                    <!-- HORIZONTAL ORIENTATION -->
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding #Root.IsHorizontal}">
                        <Grid MinWidth="110" Height="48">
                            <!-- 1. Pill Style (Horizontal) -->
                            <Grid IsVisible="{Binding #Root.IsPillStyle}" ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="{Binding #Root.LabelOff}"
                                           Foreground="{Binding #Root.OffLabelBrush}"
                                           FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border Grid.Column="1" Width="52" Height="26" CornerRadius="13"
                                        Background="{Binding #Root.TrackBackground}"
                                        BorderBrush="{Binding #Root.TrackBorderBrush}" BorderThickness="1.5">
                                    <Grid>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#FFFFFF"
                                                HorizontalAlignment="Left" Margin="3,0"
                                                IsVisible="{Binding !#Root.IsActive}">
                                            <Ellipse Width="6" Height="6" Fill="#55555A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#FFFFFF"
                                                HorizontalAlignment="Right" Margin="3,0"
                                                IsVisible="{Binding #Root.IsActive}">
                                            <Ellipse Width="6" Height="6" Fill="{Binding #Root.BrushOn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding #Root.LabelOn}"
                                           Foreground="{Binding #Root.OnLabelBrush}"
                                           FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>

                            <!-- 2. Rocker Style (Horizontal) -->
                            <Grid IsVisible="{Binding #Root.IsRockerStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="110" Height="36">
                                <Border Background="#16171A" BorderBrush="#3C3D42" BorderThickness="1.5" CornerRadius="5" Padding="2">
                                    <Grid ColumnDefinitions="*,1.5,*">
                                        <!-- Left Shoulder (OFF) -->
                                        <Border Grid.Column="0" CornerRadius="3,0,0,3" Background="{Binding #Root.InactiveShoulderBg}" Padding="6,2">
                                            <Grid RowDefinitions="*,Auto">
                                                <TextBlock Grid.Row="0" Text="{Binding #Root.LabelOff}"
                                                           Foreground="{Binding #Root.OffLabelBrush}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Row="1" Width="18" Height="3" CornerRadius="1.5" Background="{Binding #Root.BrushOff}"
                                                        HorizontalAlignment="Center" Margin="0,0,0,2" IsVisible="{Binding !#Root.IsActive}" />
                                                <Border Grid.Row="1" Width="18" Height="3" CornerRadius="1.5" Background="#333336"
                                                        HorizontalAlignment="Center" Margin="0,0,0,2" IsVisible="{Binding #Root.IsActive}" />
                                            </Grid>
                                        </Border>
                                        <Rectangle Grid.Column="1" Fill="#0F1012" />
                                        <!-- Right Shoulder (ON) -->
                                        <Border Grid.Column="2" CornerRadius="0,3,3,0" Background="{Binding #Root.ActiveShoulderBg}" Padding="6,2">
                                            <Grid RowDefinitions="*,Auto">
                                                <TextBlock Grid.Row="0" Text="{Binding #Root.LabelOn}"
                                                           Foreground="{Binding #Root.OnLabelBrush}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Row="1" Width="18" Height="3" CornerRadius="1.5" Background="{Binding #Root.BrushOn}"
                                                        HorizontalAlignment="Center" Margin="0,0,0,2" IsVisible="{Binding #Root.IsActive}" />
                                                <Border Grid.Row="1" Width="18" Height="3" CornerRadius="1.5" Background="#333336"
                                                        HorizontalAlignment="Center" Margin="0,0,0,2" IsVisible="{Binding !#Root.IsActive}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 3. Lever Style (Horizontal) -->
                            <Grid IsVisible="{Binding #Root.IsLeverStyle}" ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse Width="6" Height="6" Fill="{Binding #Root.BrushOff}" IsVisible="{Binding !#Root.IsActive}" />
                                    <Ellipse Width="6" Height="6" Fill="#444448" IsVisible="{Binding #Root.IsActive}" />
                                    <TextBlock Text="{Binding #Root.LabelOff}" Foreground="{Binding #Root.OffLabelBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="38" Height="38" CornerRadius="19" Background="#28292E" BorderBrush="#55575E" BorderThickness="2">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#141517" BorderBrush="#38393F" BorderThickness="1.5">
                                            <Ellipse Width="8" Height="8" Fill="#090A0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Border>
                                    <Canvas Width="40" Height="40" IsVisible="{Binding !#Root.IsActive}">
                                        <Path Data="M 20,20 L 7,8" Stroke="#BAC0C6" StrokeThickness="4.5" StrokeLineCap="Round" />
                                        <Ellipse Canvas.Left="3" Canvas.Top="4" Width="8" Height="8" Fill="#E0E4E8" Stroke="#787C82" StrokeThickness="1" />
                                    </Canvas>
                                    <Canvas Width="40" Height="40" IsVisible="{Binding #Root.IsActive}">
                                        <Path Data="M 20,20 L 33,8" Stroke="#BAC0C6" StrokeThickness="4.5" StrokeLineCap="Round" />
                                        <Ellipse Canvas.Left="29" Canvas.Top="4" Width="8" Height="8" Fill="{Binding #Root.BrushOn}" Stroke="#FFFFFF" StrokeThickness="1" />
                                    </Canvas>
                                </Grid>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding #Root.LabelOn}" Foreground="{Binding #Root.OnLabelBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Ellipse Width="6" Height="6" Fill="{Binding #Root.BrushOn}" IsVisible="{Binding #Root.IsActive}" />
                                    <Ellipse Width="6" Height="6" Fill="#444448" IsVisible="{Binding !#Root.IsActive}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Viewbox>

                    <!-- VERTICAL ORIENTATION -->
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding #Root.IsVertical}">
                        <Grid Width="48" MinHeight="110">
                            <!-- 1. Pill Style (Vertical) -->
                            <Grid IsVisible="{Binding #Root.IsPillStyle}" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Grid.Row="0" Text="{Binding #Root.LabelOn}"
                                           Foreground="{Binding #Root.OnLabelBrush}"
                                           FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <Border Grid.Row="1" Width="26" Height="52" CornerRadius="13"
                                        Background="{Binding #Root.TrackBackground}"
                                        BorderBrush="{Binding #Root.TrackBorderBrush}" BorderThickness="1.5">
                                    <Grid>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#FFFFFF"
                                                VerticalAlignment="Top" Margin="0,3"
                                                IsVisible="{Binding #Root.IsActive}">
                                            <Ellipse Width="6" Height="6" Fill="{Binding #Root.BrushOn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#FFFFFF"
                                                VerticalAlignment="Bottom" Margin="0,3"
                                                IsVisible="{Binding !#Root.IsActive}">
                                            <Ellipse Width="6" Height="6" Fill="#55555A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="2" Text="{Binding #Root.LabelOff}"
                                           Foreground="{Binding #Root.OffLabelBrush}"
                                           FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </Grid>

                            <!-- 2. Rocker Style (Vertical) -->
                            <Grid IsVisible="{Binding #Root.IsRockerStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" MinHeight="110">
                                <Border Background="#16171A" BorderBrush="#3C3D42" BorderThickness="1.5" CornerRadius="5" Padding="2">
                                    <Grid RowDefinitions="*,1.5,*">
                                        <!-- Top Shoulder (ON) -->
                                        <Border Grid.Row="0" CornerRadius="3,3,0,0" Background="{Binding #Root.ActiveShoulderBg}" Padding="2,4">
                                            <Grid RowDefinitions="Auto,*">
                                                <Border Grid.Row="0" Width="18" Height="3" CornerRadius="1.5" Background="{Binding #Root.BrushOn}"
                                                        HorizontalAlignment="Center" Margin="0,2,0,0" IsVisible="{Binding #Root.IsActive}" />
                                                <Border Grid.Row="0" Width="18" Height="3" CornerRadius="1.5" Background="#333336"
                                                        HorizontalAlignment="Center" Margin="0,2,0,0" IsVisible="{Binding !#Root.IsActive}" />
                                                <TextBlock Grid.Row="1" Text="{Binding #Root.LabelOn}"
                                                           Foreground="{Binding #Root.OnLabelBrush}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                        <Rectangle Grid.Row="1" Fill="#0F1012" />
                                        <!-- Bottom Shoulder (OFF) -->
                                        <Border Grid.Row="2" CornerRadius="0,0,3,3" Background="{Binding #Root.InactiveShoulderBg}" Padding="2,4">
                                            <Grid RowDefinitions="*,Auto">
                                                <TextBlock Grid.Row="0" Text="{Binding #Root.LabelOff}"
                                                           Foreground="{Binding #Root.OffLabelBrush}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Row="1" Width="18" Height="3" CornerRadius="1.5" Background="{Binding #Root.BrushOff}"
                                                        HorizontalAlignment="Center" Margin="0,0,0,2" IsVisible="{Binding !#Root.IsActive}" />
                                                <Border Grid.Row="1" Width="18" Height="3" CornerRadius="1.5" Background="#333336"
                                                        HorizontalAlignment="Center" Margin="0,0,0,2" IsVisible="{Binding #Root.IsActive}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 3. Lever Style (Vertical) -->
                            <Grid IsVisible="{Binding #Root.IsLeverStyle}" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="2" Margin="0,0,0,6">
                                    <Ellipse Width="6" Height="6" Fill="{Binding #Root.BrushOn}" HorizontalAlignment="Center" IsVisible="{Binding #Root.IsActive}" />
                                    <Ellipse Width="6" Height="6" Fill="#444448" HorizontalAlignment="Center" IsVisible="{Binding !#Root.IsActive}" />
                                    <TextBlock Text="{Binding #Root.LabelOn}" Foreground="{Binding #Root.OnLabelBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <Grid Grid.Row="1" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="38" Height="38" CornerRadius="19" Background="#28292E" BorderBrush="#55575E" BorderThickness="2">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#141517" BorderBrush="#38393F" BorderThickness="1.5">
                                            <Ellipse Width="8" Height="8" Fill="#090A0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Border>
                                    <Canvas Width="40" Height="40" IsVisible="{Binding !#Root.IsActive}">
                                        <Path Data="M 20,20 L 12,33" Stroke="#BAC0C6" StrokeThickness="4.5" StrokeLineCap="Round" />
                                        <Ellipse Canvas.Left="8" Canvas.Top="29" Width="8" Height="8" Fill="#E0E4E8" Stroke="#787C82" StrokeThickness="1" />
                                    </Canvas>
                                    <Canvas Width="40" Height="40" IsVisible="{Binding #Root.IsActive}">
                                        <Path Data="M 20,20 L 28,7" Stroke="#BAC0C6" StrokeThickness="4.5" StrokeLineCap="Round" />
                                        <Ellipse Canvas.Left="24" Canvas.Top="3" Width="8" Height="8" Fill="{Binding #Root.BrushOn}" Stroke="#FFFFFF" StrokeThickness="1" />
                                    </Canvas>
                                </Grid>
                                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="2" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding #Root.LabelOff}" Foreground="{Binding #Root.OffLabelBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <Ellipse Width="6" Height="6" Fill="{Binding #Root.BrushOff}" HorizontalAlignment="Center" IsVisible="{Binding !#Root.IsActive}" />
                                    <Ellipse Width="6" Height="6" Fill="#444448" HorizontalAlignment="Center" IsVisible="{Binding #Root.IsActive}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Grid>
        </Grid>
    </Button>
</UserControl>
