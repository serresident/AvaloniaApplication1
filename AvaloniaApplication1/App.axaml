<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AvaloniaApplication1.Converters"
             x:Class="AvaloniaApplication1.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Default Theme Variant (Aliases Dark for industrial SCADA) -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ThemeCanvasBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ThemeForegroundBrush" Color="#D4D4D4" />
                    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#252526" />
                    <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#252526" />
                    <SolidColorBrush x:Key="ThemeHeaderBrush" Color="#2B2B2E" />
                    <SolidColorBrush x:Key="ThemeToolbarBrush" Color="#1E1E20" />
                    <SolidColorBrush x:Key="ThemeSubtleBrush" Color="#202022" />
                    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#38383C" />
                    <SolidColorBrush x:Key="ThemeSeparatorBrush" Color="#3E3E42" />
                    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#9CDCFE" />
                    <SolidColorBrush x:Key="ThemeMutedTextBrush" Color="#858585" />
                    <SolidColorBrush x:Key="ThemeGridLineBrush" Color="#333333" />
                    <SolidColorBrush x:Key="ThemeTabActiveBrush" Color="#007ACC" />
                    <SolidColorBrush x:Key="ThemeTabInactiveBrush" Color="#2D2D30" />
                    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#007ACC" />
                </ResourceDictionary>

                <!-- Industrial SCADA Dark Theme -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ThemeCanvasBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ThemeForegroundBrush" Color="#D4D4D4" />
                    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#252526" />
                    <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#252526" />
                    <SolidColorBrush x:Key="ThemeHeaderBrush" Color="#2B2B2E" />
                    <SolidColorBrush x:Key="ThemeToolbarBrush" Color="#1E1E20" />
                    <SolidColorBrush x:Key="ThemeSubtleBrush" Color="#202022" />
                    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#38383C" />
                    <SolidColorBrush x:Key="ThemeSeparatorBrush" Color="#3E3E42" />
                    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#9CDCFE" />
                    <SolidColorBrush x:Key="ThemeMutedTextBrush" Color="#858585" />
                    <SolidColorBrush x:Key="ThemeGridLineBrush" Color="#333333" />
                    <SolidColorBrush x:Key="ThemeTabActiveBrush" Color="#007ACC" />
                    <SolidColorBrush x:Key="ThemeTabInactiveBrush" Color="#2D2D30" />
                    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#007ACC" />
                </ResourceDictionary>

                <!-- High-Contrast Clean SCADA Light Theme -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#F3F3F5" />
                    <SolidColorBrush x:Key="ThemeCanvasBackgroundBrush" Color="#F8F9FA" />
                    <SolidColorBrush x:Key="ThemeForegroundBrush" Color="#1F2428" />
                    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ThemeHeaderBrush" Color="#E1E4E8" />
                    <SolidColorBrush x:Key="ThemeToolbarBrush" Color="#EAECEF" />
                    <SolidColorBrush x:Key="ThemeSubtleBrush" Color="#E4E7EB" />
                    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#D0D7DE" />
                    <SolidColorBrush x:Key="ThemeSeparatorBrush" Color="#D0D7DE" />
                    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#1F2428" />
                    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#0969DA" />
                    <SolidColorBrush x:Key="ThemeMutedTextBrush" Color="#57606A" />
                    <SolidColorBrush x:Key="ThemeGridLineBrush" Color="#D8DEE4" />
                    <SolidColorBrush x:Key="ThemeTabActiveBrush" Color="#0969DA" />
                    <SolidColorBrush x:Key="ThemeTabInactiveBrush" Color="#D0D7DE" />
                    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#0969DA" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
