<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="440"
        x:Class="AvaloniaApplication1.Views.PasswordPromptWindow"
        x:DataType="vm:PasswordPromptViewModel"
        x:CompileBindings="True"
        Title="{Binding Title}"
        Width="360" Height="450"
        MinWidth="340" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1E1E1E">

    <Border Padding="20" Background="#252526" CornerRadius="8" Margin="10" BorderBrush="#3E3E42" BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" VerticalAlignment="Stretch">
            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="6" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="🔒" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                <TextBlock Text="Введите пароль администратора" FontSize="12" Foreground="#858585" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Password Box -->
            <TextBox Grid.Row="1"
                     Text="{Binding Password, Mode=TwoWay}"
                     PasswordChar="●"
                     FontSize="20"
                     FontWeight="Bold"
                     TextAlignment="Center"
                     Background="#1E1E1E"
                     Foreground="#4EC9B0"
                     BorderBrush="#007ACC"
                     BorderThickness="1.5"
                     CornerRadius="4"
                     Height="40"
                     Margin="0,0,0,8" />

            <!-- Error Message -->
            <TextBlock Grid.Row="2"
                       Text="{Binding ErrorMessage}"
                       Foreground="#FF5252"
                       FontSize="12"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding HasError}"
                       Margin="0,0,0,8" />

            <!-- On-Screen Numeric Keypad (for touchscreens) -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*,*" RowDefinitions="*,*,*,*" Margin="0,4,0,12">
                <Button Grid.Row="0" Grid.Column="0" Content="1" Command="{Binding AppendDigitCommand}" CommandParameter="1" Classes="pinKey" />
                <Button Grid.Row="0" Grid.Column="1" Content="2" Command="{Binding AppendDigitCommand}" CommandParameter="2" Classes="pinKey" />
                <Button Grid.Row="0" Grid.Column="2" Content="3" Command="{Binding AppendDigitCommand}" CommandParameter="3" Classes="pinKey" />

                <Button Grid.Row="1" Grid.Column="0" Content="4" Command="{Binding AppendDigitCommand}" CommandParameter="4" Classes="pinKey" />
                <Button Grid.Row="1" Grid.Column="1" Content="5" Command="{Binding AppendDigitCommand}" CommandParameter="5" Classes="pinKey" />
                <Button Grid.Row="1" Grid.Column="2" Content="6" Command="{Binding AppendDigitCommand}" CommandParameter="6" Classes="pinKey" />

                <Button Grid.Row="2" Grid.Column="0" Content="7" Command="{Binding AppendDigitCommand}" CommandParameter="7" Classes="pinKey" />
                <Button Grid.Row="2" Grid.Column="1" Content="8" Command="{Binding AppendDigitCommand}" CommandParameter="8" Classes="pinKey" />
                <Button Grid.Row="2" Grid.Column="2" Content="9" Command="{Binding AppendDigitCommand}" CommandParameter="9" Classes="pinKey" />

                <Button Grid.Row="3" Grid.Column="0" Content="C" Command="{Binding ClearCommand}" Classes="pinKey special" />
                <Button Grid.Row="3" Grid.Column="1" Content="0" Command="{Binding AppendDigitCommand}" CommandParameter="0" Classes="pinKey" />
                <Button Grid.Row="3" Grid.Column="2" Content="⌫" Command="{Binding BackspaceCommand}" Classes="pinKey special" />
            </Grid>

            <!-- Bottom Action Buttons -->
            <Grid Grid.Row="4" ColumnDefinitions="*,10,*">
                <Button Grid.Column="0"
                        Content="Отмена"
                        Command="{Binding CancelCommand}"
                        Background="#3E3E42"
                        Foreground="White"
                        CornerRadius="4"
                        Height="36"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />

                <Button Grid.Column="2"
                        Content="Войти"
                        Command="{Binding ConfirmCommand}"
                        IsDefault="True"
                        Background="#0E639C"
                        Foreground="White"
                        FontWeight="Bold"
                        CornerRadius="4"
                        Height="36"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />
            </Grid>
        </Grid>
    </Border>

    <Window.Styles>
        <Style Selector="Button.pinKey">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="#333337" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pinKey:pointerover">
            <Setter Property="Background" Value="#007ACC" />
        </Style>
        <Style Selector="Button.pinKey.special">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="#9CDCFE" />
        </Style>
    </Window.Styles>
</Window>
