<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels"
        xmlns:models="clr-namespace:AvaloniaApplication1.Models"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="520"
        x:Class="AvaloniaApplication1.Views.TagPickerWindow"
        x:DataType="vm:TagPickerViewModel"
        x:CompileBindings="True"
        Title="🏷️ Выбор тега из базы проекта (Tag Picker)"
        Width="800" Height="520"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

        <!-- Title & Search Header -->
        <TextBlock Grid.Row="0" Text="🏷️ Выберите тег из базы TagManager"
                   Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

        <!-- Search Bar -->
        <TextBox Grid.Row="1"
                 Text="{Binding SearchText}"
                 PlaceholderText="🔍 Поиск по ID тега, имени, адресу или подключению..."
                 Background="#2D2D30" Foreground="White"
                 CornerRadius="4" Padding="10,8" Margin="0,0,0,10" />

        <!-- Tag Table -->
        <Border Grid.Row="2" Background="#252526" CornerRadius="6" BorderBrush="#3F3F46" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <!-- Column Header -->
                <Border Grid.Row="0" Background="#1F1F22" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="8,6">
                    <Grid ColumnDefinitions="140,180,90,90,70,55,*">
                        <TextBlock Grid.Column="0" Text="TagId" Foreground="#9CDCFE" FontSize="11" FontWeight="Bold" Margin="4,0" />
                        <TextBlock Grid.Column="1" Text="Наименование" Foreground="#CCCCCC" FontSize="11" FontWeight="Bold" Margin="4,0" />
                        <TextBlock Grid.Column="2" Text="Драйвер" Foreground="#4EC9B0" FontSize="11" FontWeight="Bold" Margin="4,0" />
                        <TextBlock Grid.Column="3" Text="Адрес" Foreground="#DCDCAA" FontSize="11" FontWeight="Bold" Margin="4,0" />
                        <TextBlock Grid.Column="4" Text="Тип" Foreground="#C586C0" FontSize="11" FontWeight="Bold" Margin="4,0" />
                        <TextBlock Grid.Column="5" Text="Ед." Foreground="#CCCCCC" FontSize="11" FontWeight="Bold" Margin="4,0" />
                        <TextBlock Grid.Column="6" Text="Масштаб Y" Foreground="#B5CEA8" FontSize="11" FontWeight="Bold" Margin="4,0" />
                    </Grid>
                </Border>

                <!-- Virtualized Tag Rows -->
                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredTags}"
                         SelectedItem="{Binding SelectedTag}"
                         Background="Transparent"
                         DoubleTapped="OnRowDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:TagDefinition">
                            <Grid ColumnDefinitions="140,180,90,90,70,55,*" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding TagId}"
                                           FontFamily="Consolas, monospace" Foreground="#9CDCFE" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TagId}"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <Border Grid.Column="2" Background="#2A3344" CornerRadius="3" Padding="4,1"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding ConnId}" Foreground="#4EC9B0" FontSize="11" />
                                </Border>

                                <TextBlock Grid.Column="3" Text="{Binding Address}"
                                           FontFamily="Consolas, monospace" Foreground="#DCDCAA"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Address}"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <TextBlock Grid.Column="4" Text="{Binding DataType}"
                                           Foreground="#C586C0" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <TextBlock Grid.Column="5" Text="{Binding Unit}"
                                           Foreground="#CCCCCC" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <TextBlock Grid.Column="6" Text="{Binding ScalingDisplay}"
                                           FontFamily="Consolas, monospace" Foreground="#B5CEA8" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Background="#3E3E42" Foreground="White"
                    CornerRadius="6" Padding="16,8" FontSize="13"
                    HorizontalAlignment="Left" />

            <Button Grid.Column="1" Content="✓ Выбрать тег"
                    Command="{Binding ConfirmCommand}"
                    Background="#0E639C" Foreground="White"
                    CornerRadius="6" Padding="20,8" FontSize="13" FontWeight="SemiBold"
                    HorizontalAlignment="Right" />
        </Grid>

    </Grid>
</Window>
