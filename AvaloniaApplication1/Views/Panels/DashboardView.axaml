<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmPanels="clr-namespace:AvaloniaApplication1.ViewModels.Panels"
             xmlns:vmCore="clr-namespace:AvaloniaApplication1.ViewModels.Core"
             xmlns:vmWidgets="clr-namespace:AvaloniaApplication1.ViewModels.Widgets"
             xmlns:vmWindows="clr-namespace:AvaloniaApplication1.ViewModels.Windows.Common"
             xmlns:canvas="clr-namespace:AvaloniaApplication1.Views.Canvas"
             xmlns:canvasOverlays="clr-namespace:AvaloniaApplication1.Views.Canvas.Overlays"
             xmlns:panels="clr-namespace:AvaloniaApplication1.Views.Panels"
             xmlns:scada="https://github.com/avaloniaapplication1/controls"
             xmlns:c="clr-namespace:AvaloniaApplication1.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication1.Views.Panels.DashboardView"
             x:DataType="vmPanels:DashboardViewModel"
             x:CompileBindings="True">

     <UserControl.Resources>
         <c:BoolToBrushConverter x:Key="BoolToColor" TrueBrush="#FF0000" FalseBrush="#440000" />
         <c:BoolToBrushConverter x:Key="BoolToBorderBg" TrueResourceKey="ThemeCardBackgroundBrush" TrueBrush="#2D2D30" FalseBrush="Transparent" />
         <c:BoolToBrushConverter x:Key="BoolToBorderStroke" TrueResourceKey="ThemeBorderBrush" TrueBrush="#3E3E42" FalseBrush="Transparent" />
         <c:HexToBrushConverter x:Key="HexToBrush" />
     </UserControl.Resources>

     <UserControl.Styles>
         <Style Selector="Button.hmi-compact">
             <Setter Property="Padding" Value="2,1" />
             <Setter Property="MinHeight" Value="14" />
             <Setter Property="MinWidth" Value="14" />
             <Setter Property="HorizontalContentAlignment" Value="Center" />
             <Setter Property="VerticalContentAlignment" Value="Center" />
         </Style>
         <Style Selector="Border.widget-card">
             <Setter Property="Background" Value="Transparent" />
             <Setter Property="BorderBrush" Value="Transparent" />
         </Style>
         <Style Selector="Border.widget-card.has-border">
             <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}" />
             <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
         </Style>
     </UserControl.Styles>

     <Grid>
         <ScrollViewer Name="DashboardScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
             <LayoutTransformControl Name="ZoomControl">
                 <LayoutTransformControl.LayoutTransform>
                     <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
                 </LayoutTransformControl.LayoutTransform>
                 <Grid>
                     <canvasOverlays:GridOverlay x:Name="DashboardGridOverlay" Margin="10" IsHitTestVisible="False" />
                     <ItemsControl ItemsSource="{Binding Widgets}" x:Name="WidgetsItemsControl">
                     <ItemsControl.Styles>
                         <Style Selector="ContentPresenter" x:DataType="vmCore:WidgetViewModelBase">
                             <Setter Property="canvas:DashboardPanel.Col" Value="{Binding Col, Mode=TwoWay}" />
                             <Setter Property="canvas:DashboardPanel.Row" Value="{Binding Row, Mode=TwoWay}" />
                             <Setter Property="canvas:DashboardPanel.SizeX" Value="{Binding SizeX, Mode=TwoWay}" />
                             <Setter Property="canvas:DashboardPanel.SizeY" Value="{Binding SizeY, Mode=TwoWay}" />
                             <Setter Property="Opacity" Value="{Binding EffectiveOpacity}" />
                             <Setter Property="ToolTip.Tip" Value="{Binding QualityToolTip}" />
                         </Style>
                     </ItemsControl.Styles>
                     <ItemsControl.ItemsPanel>
                         <ItemsPanelTemplate>
                             <canvas:DashboardPanel CellWidth="{Binding CellWidth}" CellHeight="{Binding CellHeight}" Margin="10" IsDesignMode="{Binding ProjectContext.IsDesignMode}" Background="Transparent" />
                         </ItemsPanelTemplate>
                     </ItemsControl.ItemsPanel>
                     
                     <ItemsControl.DataTemplates>
                      <!-- ValueDisplay -->
                      <DataTemplate DataType="{x:Type vmWidgets:ValueDisplayViewModel}">
                          <canvasOverlays:WidgetChrome CardPadding="4,2">
                              <scada:ValueDisplayControl Title="{Binding Title}"
                                                         ShowTitle="{Binding ShowTitle}"
                                                         DisplayValue="{Binding DisplayValue}"
                                                         ValueBrush="{Binding ValueColor, Converter={StaticResource HexToBrush}}" />
                          </canvasOverlays:WidgetChrome>
                      </DataTemplate>
                      
                      <!-- PilotLight -->
                      <DataTemplate DataType="{x:Type vmWidgets:PilotLightViewModel}">
                          <canvasOverlays:WidgetChrome CardPadding="4,2">
                              <Grid RowDefinitions="Auto,*">
                                  <Viewbox Grid.Row="0" MaxHeight="14" Stretch="Uniform" HorizontalAlignment="Center" IsVisible="{Binding ShowTitle}">
                                      <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12" HorizontalAlignment="Center" />
                                  </Viewbox>
                                  <scada:PilotLightControl Grid.Row="1" Margin="2"
                                                           IsOn="{Binding IsOn}"
                                                           ActiveColor="{Binding TypedConfig.TrueColor}"
                                                           InactiveColor="{Binding TypedConfig.FalseColor}" />
                              </Grid>
                          </canvasOverlays:WidgetChrome>
                      </DataTemplate>

                      <!-- CommandButton -->
                      <DataTemplate DataType="{x:Type vmWidgets:CommandButtonViewModel}">
                          <canvasOverlays:WidgetChrome CardPadding="0">
                              <scada:CommandButtonControl Command="{Binding ExecuteCommandCommand}"
                                                          Title="{Binding Title}"
                                                          ShowTitle="{Binding ShowTitle}"
                                                          IsToggleSwitchMode="{Binding IsToggleSwitchMode}"
                                                          IsHorizontal="{Binding IsHorizontal}"
                                                          IsVertical="{Binding IsVertical}"
                                                          IsPillStyle="{Binding IsPillStyle}"
                                                          IsRockerStyle="{Binding IsRockerStyle}"
                                                          IsLeverStyle="{Binding IsLeverStyle}"
                                                          IsActive="{Binding IsActive}"
                                                          LabelOn="{Binding TypedConfig.LabelOn}"
                                                          LabelOff="{Binding TypedConfig.LabelOff}"
                                                          CurrentLabel="{Binding CurrentLabel}"
                                                          ButtonBackground="{Binding ButtonBackground}"
                                                          BrushOn="{Binding BrushOn}"
                                                          BrushOff="{Binding BrushOff}"
                                                          TrackBackground="{Binding TrackBackground}"
                                                          TrackBorderBrush="{Binding TrackBorderBrush}"
                                                          ActiveShoulderBg="{Binding ActiveShoulderBg}"
                                                          InactiveShoulderBg="{Binding InactiveShoulderBg}"
                                                          OnLabelBrush="{Binding OnLabelBrush}"
                                                          OffLabelBrush="{Binding OffLabelBrush}" />
                          </canvasOverlays:WidgetChrome>
                      </DataTemplate>

                      <!-- ContainerButton -->
                      <DataTemplate DataType="{x:Type vmWidgets:ContainerButtonViewModel}">
                          <Grid ClipToBounds="False">
                              <Border Classes="widget-card" Classes.has-border="{Binding ShowBorder}"
                                      BorderThickness="1" CornerRadius="6" Margin="1" Padding="0">
                                  <scada:ContainerButtonControl Command="{Binding OpenContainerCommand}"
                                                                Title="{Binding Title}" />
                              </Border>
                              <!-- Design Overlay -->
                              <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
                                  <Grid ClipToBounds="False">
                                       <!-- Header Grip Bar -->
                                       <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                           <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                       </Border>
                                       <!-- Floating Toolbar -->
                                       <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-36,0,0" Height="28" Background="{DynamicResource ThemeToolbarBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,2" ZIndex="105" BoxShadow="0 2 8 0 #80000000">
                                           <StackPanel Orientation="Horizontal" Spacing="6">
                                               <Button Command="{Binding OpenContainerCommand}" Content="➡️" ToolTip.Tip="Открыть контейнер" FontSize="12" Width="22" Height="22" Padding="0" Background="Transparent" Foreground="White" />
                                           </StackPanel>
                                       </Border>
                                       <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                   </Grid>
                              </Border>
                          </Grid>
                      </DataTemplate>

                      <!-- Slider -->
                      <DataTemplate DataType="{x:Type vmWidgets:SliderViewModel}">
                          <canvasOverlays:WidgetChrome CardPadding="4">
                              <scada:SliderControl Title="{Binding Title}"
                                                   ShowTitle="{Binding ShowTitle}"
                                                   Minimum="0" Maximum="100"
                                                   Value="{Binding SliderValue, Mode=TwoWay}" />
                          </canvasOverlays:WidgetChrome>
                      </DataTemplate>

                      <!-- SetValue -->
                      <DataTemplate DataType="{x:Type vmWidgets:SetValueViewModel}">
                          <canvasOverlays:WidgetChrome CardPadding="0">
                              <scada:SetValueControl Command="{Binding InputSetpointCommand}"
                                                     Title="{Binding Title}"
                                                     ShowTitle="{Binding ShowTitle}"
                                                     DisplayValue="{Binding DisplayValue}"
                                                     ValueBrush="{Binding ValueColor, Converter={StaticResource HexToBrush}}" />
                          </canvasOverlays:WidgetChrome>
                      </DataTemplate>

                      <!-- RealTimeTrend -->
                      <DataTemplate DataType="{x:Type vmWidgets:RealTimeTrendViewModel}">
                          <Grid ClipToBounds="False">
                              <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="1" Padding="6">
                                  <Grid RowDefinitions="Auto,*,Auto">
                                      <!-- Header with Live Value & Pause Button -->
                                      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                                          <!-- Pause / Resume Toggle -->
                                          <Button Grid.Column="0"
                                                  Command="{Binding TogglePauseCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="2,0"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center"
                                                  ToolTip.Tip="Приостановить / возобновить тренд">
                                              <Panel>
                                                  <TextBlock Text="⏸" IsVisible="{Binding !IsPaused}" Foreground="#AAAAAA" FontSize="11" />
                                                  <TextBlock Text="▶" IsVisible="{Binding IsPaused}" Foreground="#00FFCC" FontSize="11" />
                                              </Panel>
                                          </Button>

                                          <Viewbox Grid.Column="1" MaxHeight="14" Stretch="Uniform" HorizontalAlignment="Left">
                                              <TextBlock Text="{Binding Title}" Foreground="Gray" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                          </Viewbox>
                                          <Viewbox Grid.Column="2" MaxHeight="14" Stretch="Uniform" HorizontalAlignment="Right">
                                              <TextBlock Text="{Binding LatestValueDisplay}" Foreground="#00FFCC" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                          </Viewbox>
                                      </Grid>

                                      <!-- Center Area: Dual Y-Axes, Chart, Time X-Axis -->
                                      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto" Margin="0,2,0,2">
                                          <!-- Left Y-Axis Scale -->
                                          <Grid Grid.Column="0" Grid.Row="0" Width="26" Margin="0,0,2,0">
                                              <TextBlock Text="{Binding LeftMaxY}" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="8" Foreground="#888888" />
                                              <TextBlock Text="{Binding LeftMidY}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="8" Foreground="#666666" />
                                              <TextBlock Text="{Binding LeftMinY}" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="8" Foreground="#888888" />
                                          </Grid>

                                          <!-- Main Chart Area & Crosshair Overlay -->
                                          <Grid Grid.Column="1" Grid.Row="0">
                                              <scada:TrendLineControl
                                                  Pens="{Binding Pens}"
                                                  Values="{Binding Values}"
                                                  SampleTick="{Binding SampleTick}"
                                                  ScalingMode="{Binding ScalingMode}"
                                                  MinY="{Binding LeftMinY}"
                                                  MaxY="{Binding LeftMaxY}"
                                                  RightMinY="{Binding RightMinY}"
                                                  RightMaxY="{Binding RightMaxY}"
                                                  ShowSetpoint="{Binding ShowSetpoint}"
                                                  SetpointValue="{Binding SetpointValue}"
                                                  ShowWarningLimits="{Binding ShowWarningLimits}"
                                                  WarningHigh="{Binding WarningHigh}"
                                                  WarningLow="{Binding WarningLow}"
                                                  ShowAlarmLimits="{Binding ShowAlarmLimits}"
                                                  AlarmHigh="{Binding AlarmHigh}"
                                                  AlarmLow="{Binding AlarmLow}"
                                                  EnableCrosshair="{Binding EnableCrosshair}"
                                                  CrosshairIndex="{Binding SelectedSliceIndex, Mode=TwoWay}"
                                                  IsCrosshairActive="{Binding IsCrosshairActive, Mode=TwoWay}"
                                                  CrosshairX="{Binding CrosshairX, Mode=TwoWay}" />

                                              <!-- Crosshair Value Inspection Overlay Slice -->
                                              <Border IsVisible="{Binding IsCrosshairActive}"
                                                      Background="#E018181C"
                                                      BorderBrush="#00FFCC"
                                                      BorderThickness="1"
                                                      CornerRadius="4"
                                                      Padding="6,4"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"
                                                      Margin="4"
                                                      IsHitTestVisible="False">
                                                  <StackPanel Spacing="2">
                                                      <TextBlock Text="{Binding CrosshairTimeText}" Foreground="#AAAAAA" FontSize="9" FontWeight="Bold" />
                                                      <ItemsControl ItemsSource="{Binding CrosshairValues}">
                                                          <ItemsControl.ItemTemplate>
                                                              <DataTemplate x:DataType="vmWidgets:CrosshairSliceItem">
                                                                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,1">
                                                                      <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3" Background="{Binding PenBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                      <TextBlock Grid.Column="1" Text="{Binding PenName}" Foreground="#CCCCCC" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                      <TextBlock Grid.Column="2" Text="{Binding FormattedValue}" Foreground="White" FontSize="9" FontWeight="Bold" Margin="0,0,2,0" VerticalAlignment="Center" />
                                                                      <TextBlock Grid.Column="3" Text="{Binding Units}" Foreground="#888888" FontSize="8" VerticalAlignment="Center" />
                                                                  </Grid>
                                                              </DataTemplate>
                                                          </ItemsControl.ItemTemplate>
                                                      </ItemsControl>
                                                  </StackPanel>
                                              </Border>
                                          </Grid>

                                          <!-- Right Y-Axis Scale (Visible when HasRightAxis is true) -->
                                          <Grid Grid.Column="2" Grid.Row="0" Width="26" Margin="2,0,0,0" IsVisible="{Binding HasRightAxis}">
                                              <TextBlock Text="{Binding RightMaxY}" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="8" Foreground="#888888" />
                                              <TextBlock Text="{Binding RightMidY}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="8" Foreground="#666666" />
                                              <TextBlock Text="{Binding RightMinY}" VerticalAlignment="Bottom" HorizontalAlignment="Left" FontSize="8" Foreground="#888888" />
                                          </Grid>

                                          <!-- X-Axis Time Labels -->
                                          <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                                              <TextBlock Grid.Column="0" Text="{Binding TimeStartLabel}" FontSize="8" Foreground="#777777" HorizontalAlignment="Left" />
                                              <TextBlock Grid.Column="1" Text="{Binding TimeMidLabel}" FontSize="8" Foreground="#555555" HorizontalAlignment="Center" />
                                              <TextBlock Grid.Column="2" Text="{Binding TimeEndLabel}" FontSize="8" Foreground="#777777" HorizontalAlignment="Right" />
                                          </Grid>
                                      </Grid>

                                      <!-- Collapsible Legend Table (ISA-101 Responsive Disclosure: collapsed if SizeY < 12) -->
                                      <Border Grid.Row="2"
                                              IsVisible="{Binding IsLegendEffectiveVisible}"
                                              BorderBrush="{DynamicResource ThemeBorderBrush}"
                                              BorderThickness="0,1,0,0"
                                              Padding="0,4,0,0"
                                              Margin="0,2,0,0">
                                          <ItemsControl ItemsSource="{Binding Pens}">
                                              <ItemsControl.ItemsPanel>
                                                  <ItemsPanelTemplate>
                                                      <WrapPanel Orientation="Horizontal" />
                                                  </ItemsPanelTemplate>
                                              </ItemsControl.ItemsPanel>
                                              <ItemsControl.ItemTemplate>
                                                  <DataTemplate x:DataType="vmWidgets:TrendPenViewModel">
                                                      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,0,10,2" IsVisible="{Binding IsVisible}">
                                                          <Border Grid.Column="0" Width="8" Height="8" CornerRadius="2" Background="{Binding PenBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                          <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#BBBBBB" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                          <TextBlock Grid.Column="2" Text="{Binding LatestFormatted}"
                                                                     IsVisible="{Binding $parent[Border].((vmWidgets:RealTimeTrendViewModel)DataContext).ShowLegendLatestValue}"
                                                                     Foreground="White" FontSize="9" FontWeight="Bold" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                                                      IsVisible="{Binding $parent[Border].((vmWidgets:RealTimeTrendViewModel)DataContext).ShowLegendMinMax}"
                                                                      VerticalAlignment="Center" Margin="0,0,3,0">
                                                              <TextBlock Text="{Binding MinFormatted, StringFormat='↓{0}'}" Foreground="#888888" FontSize="8" />
                                                              <TextBlock Text="{Binding MaxFormatted, StringFormat='↑{0}'}" Foreground="#888888" FontSize="8" />
                                                          </StackPanel>
                                                          <TextBlock Grid.Column="4" Text="{Binding Units}"
                                                                     IsVisible="{Binding $parent[Border].((vmWidgets:RealTimeTrendViewModel)DataContext).ShowLegendUnits}"
                                                                     Foreground="#777777" FontSize="8" VerticalAlignment="Center" />
                                                      </Grid>
                                                  </DataTemplate>
                                              </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                      </Border>
                                  </Grid>
                              </Border>
                              <!-- Design Overlay -->
                              <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
                                  <Grid ClipToBounds="False">
                                      <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                          <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                      </Border>
                                      <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                  </Grid>
                              </Border>
                          </Grid>
                      </DataTemplate>

                       <!-- Pipe (Трубопровод) -->
                       <DataTemplate DataType="{x:Type vmWidgets:PipeWidgetViewModel}">
                           <Grid ClipToBounds="False">
                               <scada:PipeControl Points="{Binding PipePoints, Mode=TwoWay}"
                                              ShowFlanges="{Binding ShowFlanges}"
                                              Thickness="{Binding Thickness}"
                                              StartFitting="{Binding StartFitting, Mode=TwoWay}"
                                              EndFitting="{Binding EndFitting, Mode=TwoWay}"
                                              IsDesignMode="{Binding ProjectContext.IsDesignMode}"
                                              IsEditingVertices="{Binding IsEditingVertices}"
                                              ActiveColor="{Binding ActiveColor}"
                                              InactiveColor="{Binding InactiveColor}"
                                              IsFilled="{Binding IsActive}"
                                              CellSize="{Binding $parent[canvas:DashboardPanel].CellWidth}" />
                               
                               <!-- Design Overlay -->
                               <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="Transparent" ZIndex="100" ClipToBounds="False">
                                   <Grid ClipToBounds="False">
                                   </Grid>
                               </Border>
                           </Grid>
                       </DataTemplate>

                       <!-- Valve (Клапан / Задвижка) -->
                       <DataTemplate DataType="{x:Type vmWidgets:ValveWidgetViewModel}">
                           <Grid ClipToBounds="False">
                               <Button Command="{Binding OpenControlPopupCommand}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Background="Transparent" BorderThickness="0" Padding="0"
                                       ClipToBounds="False">
                                   <Grid ClipToBounds="False" RowDefinitions="*,Auto">
                                       <!-- Valve Graphic filling the widget bounds -->
                                       <scada:ValveControl Grid.Row="0"
                                           ValveType="{Binding ValveType}"
                                           IsOpen="{Binding IsOpen}"
                                           IsMoving="{Binding IsMoving}"
                                           IsSensorFault="{Binding IsSensorFault}"
                                           Setpoint="{Binding Setpoint}"
                                           Feedback="{Binding Feedback}"
                                           HasFeedbackSource="{Binding HasFeedbackSource}"
                                           IsVertical="{Binding IsVertical}"
                                           ActuatorType="{Binding ActuatorType}"
                                           ActiveColor="{Binding ActiveColor}"
                                           InactiveColor="{Binding InactiveColor}"
                                           Rotation="{Binding Rotation}"
                                           IsAlarmFlashing="{Binding IsAlarmFlashing}"
                                           IsAlarmFlashState="{Binding IsAlarmFlashState}"
                                           ShowStaticAlarmIcon="{Binding ShowStaticAlarmIcon}"
                                           ShowFeedbackBar="True" />

                                       <!-- Title and Value cleanly positioned without overflowing -->
                                       <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,1,0,0">
                                           <Viewbox MaxHeight="12" Stretch="Uniform" IsVisible="{Binding ShowTitle}">
                                               <TextBlock Text="{Binding Title}" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" />
                                           </Viewbox>
                                           <Viewbox MaxHeight="12" Stretch="Uniform" IsVisible="{Binding ShowStatusText}">
                                               <TextBlock Text="{Binding DisplayValue}" FontSize="11" FontWeight="Bold" Foreground="{Binding CurrentColor, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center" />
                                           </Viewbox>
                                       </StackPanel>
                                   </Grid>
                               </Button>

                               <!-- Design Overlay -->
                               <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
                                   <Grid ClipToBounds="False">
                                        <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                            <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                        </Border>
                                       <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                   </Grid>
                               </Border>
                           </Grid>
                       </DataTemplate>

                       <!-- Tank (Бак / Резервуар) -->
                       <DataTemplate DataType="{x:Type vmWidgets:TankWidgetViewModel}">
                           <canvasOverlays:WidgetChrome CardPadding="2">
                               <Grid RowDefinitions="Auto,*,Auto">
                                   <Viewbox Grid.Row="0" MaxHeight="13" Stretch="Uniform" HorizontalAlignment="Center" IsVisible="{Binding ShowTitle}">
                                       <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" HorizontalAlignment="Center" />
                                   </Viewbox>
                                   <scada:TankControl Grid.Row="1" Margin="4,2"
                                                      Level="{Binding CurrentLevel}"
                                                      MinValue="{Binding MinValue}"
                                                      MaxValue="{Binding MaxValue}" />
                                   <Viewbox Grid.Row="2" MaxHeight="13" Stretch="Uniform" HorizontalAlignment="Center">
                                       <TextBlock Text="{Binding DisplayValue}" Foreground="{Binding ValueColor, Converter={StaticResource HexToBrush}}" FontSize="{Binding ValueFontSize}" FontWeight="Bold" HorizontalAlignment="Center" />
                                   </Viewbox>
                               </Grid>
                           </canvasOverlays:WidgetChrome>
                       </DataTemplate>

                       <!-- Pump (Насос) -->
                       <DataTemplate DataType="{x:Type vmWidgets:PumpWidgetViewModel}">
                           <canvasOverlays:WidgetChrome CardPadding="2">
                               <Button Command="{Binding OpenControlPopupCommand}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Background="Transparent" BorderThickness="0" Padding="0">
                                   <Grid RowDefinitions="*,Auto" Margin="2">
                                       <scada:PumpControl Grid.Row="0" Margin="2"
                                                          OperationalState="{Binding OperationalState}"
                                                          IsRunning="{Binding IsRunning}"
                                                          IsManualMode="{Binding IsManualMode}"
                                                          IsFault="{Binding IsFault}"
                                                          HasWarning="{Binding HasWarning}"
                                                          IsVfdMode="{Binding IsVfdMode}"
                                                          FrequencyText="{Binding FrequencyText}"
                                                          Rotation="{Binding Rotation}"
                                                          ActiveColor="{Binding ActiveColor}"
                                                          InactiveColor="{Binding InactiveColor}" />
                                       <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,1,0,1">
                                           <Viewbox MaxHeight="12" Stretch="Uniform" IsVisible="{Binding ShowTitle}">
                                               <TextBlock Text="{Binding Title}" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" HorizontalAlignment="Center" />
                                           </Viewbox>
                                           <Viewbox MaxHeight="12" Stretch="Uniform">
                                               <TextBlock Text="{Binding DisplayValue}" FontSize="11" FontWeight="Bold" Foreground="{Binding CurrentColor, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center" />
                                           </Viewbox>
                                       </StackPanel>
                                   </Grid>
                               </Button>
                           </canvasOverlays:WidgetChrome>
                       </DataTemplate>

                       <!-- HeatExchanger (Теплообменник) -->
                       <DataTemplate DataType="{x:Type vmWidgets:HeatExchangerWidgetViewModel}">
                           <Grid ClipToBounds="False">
                               <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1.5" CornerRadius="8" Margin="3">
                                   <Grid RowDefinitions="Auto,*,Auto">
                                       <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,2" />
                                       <scada:HeatExchangerControl Grid.Row="1"
                                                              ExchangerType="{Binding ExchangerType}"
                                                              PrimaryTemp="{Binding PrimaryTemp}"
                                                              SecondaryTemp="{Binding SecondaryTemp}"
                                                              ActiveColor="{Binding ActiveColor}"
                                                              InactiveColor="{Binding InactiveColor}"
                                                              ShowFlanges="{Binding ShowFlanges}"
                                                              Margin="6,2" />
                                       <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,2,0,4">
                                           <TextBlock Text="{Binding DisplayValue}" FontSize="12" FontWeight="Bold" Foreground="{Binding ActiveColor, Converter={StaticResource HexToBrush}}" />
                                           <TextBlock Text="{Binding SecondaryTemp, StringFormat=\{0:F1\} °C}" FontSize="11" Foreground="#FFA500" />
                                       </StackPanel>
                                   </Grid>
                               </Border>

                               <!-- Design Overlay -->
                               <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="8" Margin="3" ZIndex="100" ClipToBounds="False">
                                   <Grid ClipToBounds="False">
                                        <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                            <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                        </Border>
                                       <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                   </Grid>
                               </Border>
                           </Grid>
                       </DataTemplate>

                       <!-- Reactor (Реактор с мешалкой) -->
                       <DataTemplate DataType="{x:Type vmWidgets:ReactorWidgetViewModel}">
                           <Grid ClipToBounds="False">
                               <Button Command="{Binding ToggleAgitatorCommand}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Background="Transparent" BorderThickness="0" Padding="0">
                                   <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1.5" CornerRadius="8" Margin="3">
                                       <Grid RowDefinitions="Auto,*,Auto">
                                           <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,2" />
                                           <scada:ReactorControl Grid.Row="1"
                                                            Level="{Binding CurrentLevel}"
                                                            Temperature="{Binding Temperature}"
                                                            IsAgitatorRunning="{Binding IsAgitatorRunning}"
                                                            HasJacket="{Binding HasJacket}"
                                                            ActiveColor="{Binding ActiveColor}"
                                                            InactiveColor="{Binding InactiveColor}"
                                                            Margin="6,2" />
                                           <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,2,0,4">
                                               <TextBlock Text="{Binding DisplayValue}" FontSize="12" FontWeight="Bold" Foreground="{Binding ActiveColor, Converter={StaticResource HexToBrush}}" />
                                               <TextBlock Text="{Binding Temperature, StringFormat=\{0:F1\} °C}" FontSize="11" Foreground="#FFA500" />
                                           </StackPanel>
                                       </Grid>
                                   </Border>
                               </Button>

                               <!-- Design Overlay -->
                               <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="8" Margin="3" ZIndex="100" ClipToBounds="False">
                                   <Grid ClipToBounds="False">
                                        <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                            <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                        </Border>
                                       <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                   </Grid>
                               </Border>
                           </Grid>
                       </DataTemplate>

                       <!-- LevelSensor (Датчик уровня LT) -->
                       <DataTemplate DataType="{x:Type vmWidgets:LevelSensorWidgetViewModel}">
                           <Grid ClipToBounds="False">
                               <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1.5" CornerRadius="8" Margin="3">
                                   <Grid RowDefinitions="Auto,*,Auto">
                                       <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,2" />
                                       <scada:LevelSensorControl Grid.Row="1"
                                                            Value="{Binding CurrentValue}"
                                                            TagNumber="{Binding TagNumber}"
                                                            SensorType="{Binding SensorType}"
                                                            Unit="{Binding Unit}"
                                                            MinValue="{Binding MinValue}"
                                                            MaxValue="{Binding MaxValue}"
                                                            AlarmHigh="{Binding AlarmHigh}"
                                                            AlarmLow="{Binding AlarmLow}"
                                                            Margin="4,2" />
                                       <TextBlock Grid.Row="2" Text="{Binding DisplayValue}" FontSize="12" FontWeight="Bold" Foreground="{Binding ValueColor, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center" Margin="0,2,0,4" />
                                   </Grid>
                               </Border>

                               <!-- Design Overlay -->
                               <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="8" Margin="3" ZIndex="100" ClipToBounds="False">
                                   <Grid ClipToBounds="False">
                                        <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                            <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                        </Border>
                                       <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                   </Grid>
                               </Border>
                           </Grid>
                       </DataTemplate>

                      <!-- Fallback WidgetViewModelBase -->
                      <DataTemplate DataType="{x:Type vmCore:WidgetViewModelBase}">
                          <Grid ClipToBounds="False">
                              <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="5">
                                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                      <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                                      <TextBlock Text="{Binding Type}" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" />
                                  </StackPanel>
                              </Border>
                              <!-- Design Overlay -->
                              <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="8" Margin="5" ZIndex="100" ClipToBounds="False">
                                  <Grid ClipToBounds="False">
                                        <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                            <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                        </Border>
                                      <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                  </Grid>
                              </Border>
                          </Grid>
                      </DataTemplate>
                   </ItemsControl.DataTemplates>
              </ItemsControl>
              <canvasOverlays:SelectionOverlay x:Name="DashboardSelectionOverlay" Margin="10" IsHitTestVisible="False" ClipToBounds="False" />
          </Grid>
             </LayoutTransformControl>
         </ScrollViewer>

        <!-- Floating Unified Control Toolbar (Visible only in Design Mode) -->
        <Border IsVisible="{Binding ProjectContext.IsDesignMode}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="20,0,90,20" Padding="10,6"
                Background="{DynamicResource ThemeToolbarBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                CornerRadius="8" BoxShadow="0 4 12 0 #90000000" ZIndex="1000">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Zoom Controls -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,6,2">
                    <TextBlock Text="Масштаб:" Foreground="Gray" VerticalAlignment="Center" FontSize="12" />
                    <Slider Minimum="0.5" Maximum="3.0" Value="{Binding ZoomScale, Mode=TwoWay}" Width="100" Height="24" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ZoomScale, StringFormat=\{0:P0\}}" Foreground="White" Width="40" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                    <Button Content="100%" Command="{Binding ResetZoomCommand}" FontSize="11" Padding="6,3" Background="{DynamicResource ThemeSubtleBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" CornerRadius="4" VerticalAlignment="Center">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#5A5A5D" />
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>

                <!-- Divider -->
                <Border Width="1" Background="#3E3E42" Height="16" Margin="2,0,8,0" VerticalAlignment="Center" />

                <!-- Multiselect toggle -->
                <ToggleButton IsChecked="{Binding IsMultiSelectMode, Mode=TwoWay}"
                              ToolTip.Tip="Режим мультивыбора (для кликов без зажатия Ctrl)"
                              Padding="8,4" FontSize="11" CornerRadius="4"
                              Background="{DynamicResource ThemeSubtleBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                              Margin="0,2,6,2" VerticalAlignment="Center">
                    <ToggleButton.Styles>
                        <Style Selector="ToggleButton:checked">
                            <Setter Property="Background" Value="#0E4A8E" />
                            <Setter Property="Foreground" Value="#00E5FF" />
                        </Style>
                        <Style Selector="ToggleButton:pointerover">
                            <Setter Property="Background" Value="#4E4E52" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                        <Style Selector="ToggleButton:checked:pointerover">
                            <Setter Property="Background" Value="#1565C0" />
                            <Setter Property="Foreground" Value="#80D8FF" />
                        </Style>
                    </ToggleButton.Styles>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🗂️" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Мультивыбор" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <!-- Rubber-banding toggle (🔗 Связи) -->
                <ToggleButton IsChecked="{Binding IsRubberBandingEnabled, Mode=TwoWay}"
                              ToolTip.Tip="Отслеживание связей при перемещении (🔗 Связи). Зажатый Alt временно инвертирует привязку"
                              Padding="8,4" FontSize="11" CornerRadius="4"
                              Background="{DynamicResource ThemeSubtleBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                              Margin="0,2,6,2" VerticalAlignment="Center">
                    <ToggleButton.Styles>
                        <Style Selector="ToggleButton:checked">
                            <Setter Property="Background" Value="#0E4A8E" />
                            <Setter Property="Foreground" Value="#00E5FF" />
                        </Style>
                        <Style Selector="ToggleButton:pointerover">
                            <Setter Property="Background" Value="#4E4E52" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                        <Style Selector="ToggleButton:checked:pointerover">
                            <Setter Property="Background" Value="#1565C0" />
                            <Setter Property="Foreground" Value="#80D8FF" />
                        </Style>
                    </ToggleButton.Styles>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🔗" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Связи" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <!-- Collinear Node Assembly Button -->
                <Button Command="{Binding AssembleCollinearNodeCommand}"
                        IsVisible="{Binding CanAssembleCollinear}"
                        ToolTip.Tip="Собрать соосный узел (выровнять клапан и 2 трубы по оси опорной трубы и ликвидировать зазоры)"
                        Padding="8,4" FontSize="11" Background="#1B5E20" Foreground="#A5D6A7" CornerRadius="4"
                        Margin="0,2,8,2" VerticalAlignment="Center">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#2E7D32" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                    </Button.Styles>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🔗" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Собрать узел" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Divider -->
                <Border Width="1" Background="#3E3E42" Height="16" Margin="2,0,8,0" VerticalAlignment="Center" />

                <!-- History Operations: Undo, Redo, Drawer Toggle -->
                <Button Command="{Binding UndoCommand}"
                        IsEnabled="{Binding CanUndo}"
                        ToolTip.Tip="Отменить последнее действие (Ctrl+Z)"
                        Padding="6,4" FontSize="11" CornerRadius="4"
                        Background="{DynamicResource ThemeSubtleBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                        Margin="0,2,4,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="↶" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Отменить" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RedoCommand}"
                        IsEnabled="{Binding CanRedo}"
                        ToolTip.Tip="Повторить отмененное действие (Ctrl+Y / Ctrl+Shift+Z)"
                        Padding="6,4" FontSize="11" CornerRadius="4"
                        Background="{DynamicResource ThemeSubtleBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                        Margin="0,2,4,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="↷" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Повторить" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ToggleButton IsChecked="{Binding IsHistoryPanelOpen, Mode=TwoWay}"
                              ToolTip.Tip="Открыть боковую панель истории изменений"
                              Padding="6,4" FontSize="11" CornerRadius="4"
                              Background="{DynamicResource ThemeSubtleBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                              Margin="0,2,6,2" VerticalAlignment="Center">
                    <ToggleButton.Styles>
                        <Style Selector="ToggleButton:checked">
                            <Setter Property="Background" Value="#1E3A5F" />
                            <Setter Property="Foreground" Value="#00E5FF" />
                        </Style>
                        <Style Selector="ToggleButton:pointerover">
                            <Setter Property="Background" Value="#4E4E52" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                    </ToggleButton.Styles>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="⏱️" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HistoryStepsBadgeText}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <!-- Selection Context Tools (Visible only when multiple items are selected) -->
                <!-- 1. Selection Info Badge -->
                <Border IsVisible="{Binding HasMultiSelection}"
                        Background="#202023" BorderBrush="#007ACC" BorderThickness="1"
                        CornerRadius="4" Padding="6,3" Margin="2,2,8,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🗂️" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedWidgetsCount, StringFormat='Выделено: {0}'}" 
                                   FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" FontSize="11" />
                        <TextBlock Text="{Binding SelectedWidgetsSummary}" 
                                   Foreground="#CCCCCC" VerticalAlignment="Center" FontSize="11" MaxWidth="180" 
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedWidgetsSummary}" />
                    </StackPanel>
                </Border>

                <!-- 2. Alignment Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                            IsVisible="{Binding HasMultiSelection}" Margin="0,2,8,2">
                    <StackPanel.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#4E4E52" />
                        </Style>
                    </StackPanel.Styles>
                    <Button Command="{Binding AlignLeftCommand}" ToolTip.Tip="Выровнять по левому краю" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="⇤" FontSize="13" Foreground="White" />
                    </Button>
                    <Button Command="{Binding AlignCenterHorizontalCommand}" ToolTip.Tip="Выровнять по горизонтальному центру" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="⬌" FontSize="11" Foreground="White" />
                    </Button>
                    <Button Command="{Binding AlignRightCommand}" ToolTip.Tip="Выровнять по правому краю" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="⇥" FontSize="13" Foreground="White" />
                    </Button>
                    <Button Command="{Binding AlignTopCommand}" ToolTip.Tip="Выровнять по верхнему краю" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="⇪" FontSize="13" Foreground="White" />
                    </Button>
                    <Button Command="{Binding AlignCenterVerticalCommand}" ToolTip.Tip="Выровнять по вертикальному центру" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="⬍" FontSize="11" Foreground="White" />
                    </Button>
                    <Button Command="{Binding AlignBottomCommand}" ToolTip.Tip="Выровнять по нижнему краю" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="⇩" FontSize="13" Foreground="White" />
                    </Button>
                </StackPanel>

                <!-- 3. Distribution Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                            IsVisible="{Binding HasMultiSelection}" Margin="0,2,8,2">
                    <StackPanel.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#4E4E52" />
                        </Style>
                    </StackPanel.Styles>
                    <Button Command="{Binding DistributeHorizontallyCommand}" ToolTip.Tip="Распределить равномерно по горизонтали" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="↔" FontSize="13" Foreground="White" />
                    </Button>
                    <Button Command="{Binding DistributeVerticallyCommand}" ToolTip.Tip="Распределить равномерно по вертикали" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="↕" FontSize="13" Foreground="White" />
                    </Button>
                </StackPanel>

                <!-- 4. Group & Ungroup -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            IsVisible="{Binding HasMultiSelection}" Margin="0,2,8,2">
                    <Button Command="{Binding GroupSelectedWidgetsCommand}" 
                            IsEnabled="{Binding CanGroup}"
                            ToolTip.Tip="Сгруппировать выбранные объекты (единый узел)"
                            Padding="6,3" FontSize="11" Background="#334D66" CornerRadius="3">
                        <TextBlock Text="🔗 Группа" FontSize="11" Foreground="#00E5FF" />
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#3D5C7A" />
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Command="{Binding UngroupSelectedWidgetsCommand}" 
                            IsEnabled="{Binding CanUngroup}"
                            ToolTip.Tip="Разгруппировать объекты"
                            Padding="6,3" FontSize="11" Background="#4D3333" CornerRadius="3">
                        <TextBlock Text="🔓 Разгрупп." FontSize="11" Foreground="#FF8A80" />
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#5C3D3D" />
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>

                <!-- 5. Actions: Duplicate, Delete group, Clear selection -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            IsVisible="{Binding HasMultiSelection}" Margin="0,2,0,2">
                    <Button Command="{Binding DuplicateSelectedWidgetsCommand}" 
                            ToolTip.Tip="Дублировать группу (Ctrl+D)"
                            Padding="6,3" FontSize="11" Background="#384A38" CornerRadius="3" VerticalAlignment="Center">
                        <TextBlock Text="📋 Дублировать" FontSize="11" Foreground="#69F0AE" />
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#435C43" />
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Command="{Binding RemoveSelectedWidgetsCommand}" 
                            ToolTip.Tip="Удалить группу (Delete)"
                            Padding="6,3" FontSize="11" Background="#C62828" Foreground="White" CornerRadius="3" VerticalAlignment="Center">
                        <TextBlock Text="🗑️ Удалить группу" FontSize="11" Foreground="White" />
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#E53935" />
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Command="{Binding ClearSelectionCommand}" 
                            ToolTip.Tip="Снять выделение (Esc)"
                            Padding="6,3" FontSize="11" Background="#3E3E42" Foreground="#CCCCCC" CornerRadius="3" VerticalAlignment="Center">
                        <TextBlock Text="✖ Снять" FontSize="11" />
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#4E4E52" />
                                <Setter Property="Foreground" Value="White" />
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Border>

         <!-- Global Add Widget Button (Visible only in Design Mode) -->
         <Button IsVisible="{Binding ProjectContext.IsDesignMode}" 
                 Content="+" 
                 FontSize="24" FontWeight="Bold"
                 Foreground="White" Background="#007ACC"
                 Width="56" Height="56" CornerRadius="28"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="20" ZIndex="1000"
                 Command="{Binding AddWidgetCommand}">
             <Button.Styles>
                 <Style Selector="Button:pointerover">
                     <Setter Property="Background" Value="#005A9E"/>
                 </Style>
             </Button.Styles>
         </Button>

        <!-- History Side Drawer Panel (Time-Travel Engine) -->
        <panels:HistorySidePanel DataContext="{Binding HistoryPanel}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Stretch"
                                 ZIndex="1100"
                                 IsVisible="{Binding IsOpen}" />
     </Grid>
 </UserControl>