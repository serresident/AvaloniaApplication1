<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels"
             xmlns:v="clr-namespace:AvaloniaApplication1.Views"
             xmlns:c="clr-namespace:AvaloniaApplication1.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication1.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             x:CompileBindings="True">

     <UserControl.Resources>
         <c:BoolToBrushConverter x:Key="BoolToColor" TrueBrush="#FF0000" FalseBrush="#440000" />
         <c:BoolToBrushConverter x:Key="BoolToBorderBg" TrueBrush="#2D2D30" FalseBrush="Transparent" />
         <c:BoolToBrushConverter x:Key="BoolToBorderStroke" TrueBrush="#3E3E42" FalseBrush="Transparent" />
         <c:HexToBrushConverter x:Key="HexToBrush" />
     </UserControl.Resources>

     <UserControl.Styles>
         <Style Selector="Button.hmi-compact">
             <Setter Property="Padding" Value="2,1" />
             <Setter Property="MinHeight" Value="14" />
             <Setter Property="MinWidth" Value="14" />
             <Setter Property="HorizontalContentAlignment" Value="Center" />
             <Setter Property="VerticalContentAlignment" Value="Center" />
         </Style>
     </UserControl.Styles>

     <Grid>
         <ScrollViewer Name="DashboardScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
             <LayoutTransformControl Name="ZoomControl">
                 <LayoutTransformControl.LayoutTransform>
                     <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
                 </LayoutTransformControl.LayoutTransform>
                 <Grid>
                     <v:GridOverlay x:Name="DashboardGridOverlay" Margin="10" IsHitTestVisible="False" />
                     <ItemsControl ItemsSource="{Binding Widgets}" x:Name="WidgetsItemsControl">
                     <ItemsControl.Styles>
                         <Style Selector="ContentPresenter" x:DataType="vm:WidgetViewModelBase">
                             <Setter Property="v:DashboardPanel.Col" Value="{Binding Col, Mode=TwoWay}" />
                             <Setter Property="v:DashboardPanel.Row" Value="{Binding Row, Mode=TwoWay}" />
                             <Setter Property="v:DashboardPanel.SizeX" Value="{Binding SizeX, Mode=TwoWay}" />
                             <Setter Property="v:DashboardPanel.SizeY" Value="{Binding SizeY, Mode=TwoWay}" />
                         </Style>
                     </ItemsControl.Styles>
                     <ItemsControl.ItemsPanel>
                         <ItemsPanelTemplate>
                             <v:DashboardPanel CellWidth="{Binding CellWidth}" CellHeight="{Binding CellHeight}" Margin="10" IsDesignMode="{Binding ProjectContext.IsDesignMode}" Background="Transparent" />
                         </ItemsPanelTemplate>
                     </ItemsControl.ItemsPanel>
                     
                     <ItemsControl.DataTemplates>
                      <!-- ValueDisplay -->
                      <DataTemplate DataType="{x:Type vm:ValueDisplayViewModel}">
                          <Grid ClipToBounds="False">
                              <Border Background="{Binding ShowBorder, Converter={StaticResource BoolToBorderBg}}"
                                      BorderBrush="{Binding ShowBorder, Converter={StaticResource BoolToBorderStroke}}"
                                      BorderThickness="1" CornerRadius="6" Margin="1" Padding="4,2">
                                  <Grid RowDefinitions="Auto,*">
                                      <Viewbox Grid.Row="0" MaxHeight="14" Stretch="Uniform" HorizontalAlignment="Center" IsVisible="{Binding ShowTitle}">
                                          <TextBlock Text="{Binding Title}" Foreground="#9E9E9E" FontSize="12" HorizontalAlignment="Center" />
                                      </Viewbox>
                                      <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,1">
                                          <TextBlock Text="{Binding DisplayValue}"
                                                     Foreground="{Binding ValueColor, Converter={StaticResource HexToBrush}}"
                                                     FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                      </Viewbox>
                                  </Grid>
                              </Border>
                              <!-- Design Overlay -->
                              <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
                                  <Grid ClipToBounds="False">
                                      <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                          <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                      </Border>
                                      <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                  </Grid>
                              </Border>
                          </Grid>
                      </DataTemplate>
                      
                      <!-- PilotLight -->
                      <DataTemplate DataType="{x:Type vm:PilotLightViewModel}">
                          <Grid ClipToBounds="False">
                              <Border Background="{Binding ShowBorder, Converter={StaticResource BoolToBorderBg}}"
                                      BorderBrush="{Binding ShowBorder, Converter={StaticResource BoolToBorderStroke}}"
                                      BorderThickness="1" CornerRadius="6" Margin="1" Padding="4,2">
                                  <Grid RowDefinitions="Auto,*">
                                      <Viewbox Grid.Row="0" MaxHeight="14" Stretch="Uniform" HorizontalAlignment="Center" IsVisible="{Binding ShowTitle}">
                                          <TextBlock Text="{Binding Title}" Foreground="#9E9E9E" FontSize="12" HorizontalAlignment="Center" />
                                      </Viewbox>
                                      <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2">
                                          <Ellipse Width="32" Height="32" Stroke="#222222" StrokeThickness="2" Fill="{Binding IsOn, Converter={StaticResource BoolToColor}}" />
                                      </Viewbox>
                                  </Grid>
                              </Border>
                              <!-- Design Overlay -->
                              <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
                                  <Grid ClipToBounds="False">
                                      <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                          <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                      </Border>
                                      <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                  </Grid>
                              </Border>
                          </Grid>
                      </DataTemplate>

                      <!-- CommandButton -->
                      <DataTemplate DataType="{x:Type vm:CommandButtonViewModel}">
                          <Grid ClipToBounds="False">
                              <Border Background="{Binding ShowBorder, Converter={StaticResource BoolToBorderBg}}"
                                      BorderBrush="{Binding ShowBorder, Converter={StaticResource BoolToBorderStroke}}"
                                      BorderThickness="1" CornerRadius="6" Margin="1" Padding="0">
                                  <Button Command="{Binding ExecuteCommandCommand}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Classes="hmi-compact"
                                          CornerRadius="5" Background="{Binding CurrentBackground}">
                                      <Grid>
                                          <!-- Main Label with Auto-Fit Viewbox -->
                                          <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2">
                                              <TextBlock Text="{Binding CurrentLabel}"
                                                         FontWeight="Bold"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="White" TextWrapping="Wrap" TextAlignment="Center" />
                                          </Viewbox>
                                          <!-- ToggleSwitch mode: left OFF / right ON labels -->
                                          <StackPanel Orientation="Horizontal"
                                                      IsVisible="{Binding IsToggleSwitchMode}"
                                                      VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                      Margin="0,0,0,2" Spacing="6">
                                              <TextBlock Text="{Binding TypedConfig.LabelOff}"
                                                         Foreground="#CCCCCC" FontSize="10" />
                                              <TextBlock Text="⟵" Foreground="#888888" FontSize="10"
                                                         IsVisible="{Binding !IsActive}" />
                                              <TextBlock Text="⟶" Foreground="White" FontSize="10"
                                                         IsVisible="{Binding IsActive}" />
                                              <TextBlock Text="{Binding TypedConfig.LabelOn}"
                                                         Foreground="White" FontSize="10" />
                                          </StackPanel>
                                      </Grid>
                                  </Button>
                              </Border>
                              <!-- Design Overlay -->
                              <Border IsVisible="{Binding IsSelected}" Name="DragHandle"
                                      Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2"
                                      CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
                                  <Grid ClipToBounds="False">
                                      <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                          <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                      </Border>
                                      <TextBlock Text="◢" Foreground="#007ACC" FontSize="14"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Margin="0,0,4,2" IsHitTestVisible="False" />
                                  </Grid>
                              </Border>
                          </Grid>
                      </DataTemplate>

                      <!-- ContainerButton -->
                      <DataTemplate DataType="{x:Type vm:ContainerButtonViewModel}">
                          <Grid ClipToBounds="False">
                              <Border Background="{Binding ShowBorder, Converter={StaticResource BoolToBorderBg}}"
                                      BorderBrush="{Binding ShowBorder, Converter={StaticResource BoolToBorderStroke}}"
                                      BorderThickness="1" CornerRadius="6" Margin="1" Padding="0">
                                  <Button Command="{Binding OpenContainerCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="6" Background="#005A9E" Classes="hmi-compact">
                                      <Grid RowDefinitions="Auto,*" Margin="4">
                                          <TextBlock Grid.Row="0" Text="📁" FontSize="18" HorizontalAlignment="Center" Foreground="White" />
                                          <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                              <TextBlock Text="{Binding Title}" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" />
                                          </Viewbox>
                                      </Grid>
                                  </Button>
                              </Border>
                              <!-- Design Overlay -->
                              <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
                                  <Grid ClipToBounds="False">
                                       <!-- Header Grip Bar -->
                                       <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                           <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                       </Border>
                                       <!-- Floating Toolbar -->
                                       <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-36,0,0" Height="28" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="4,2" ZIndex="105" BoxShadow="0 2 8 0 #80000000">
                                           <StackPanel Orientation="Horizontal" Spacing="6">
                                               <Button Command="{Binding OpenContainerCommand}" Content="➡️" ToolTip.Tip="Открыть контейнер" FontSize="12" Width="22" Height="22" Padding="0" Background="Transparent" Foreground="White" />
                                           </StackPanel>
                                       </Border>
                                       <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                   </Grid>
                              </Border>
                          </Grid>
                      </DataTemplate>

                      <!-- Slider -->
                      <DataTemplate DataType="{x:Type vm:SliderViewModel}">
                          <Grid ClipToBounds="False">
                              <Border Background="{Binding ShowBorder, Converter={StaticResource BoolToBorderBg}}"
                                      BorderBrush="{Binding ShowBorder, Converter={StaticResource BoolToBorderStroke}}"
                                      BorderThickness="1" CornerRadius="6" Margin="1" Padding="4">
                                  <Grid RowDefinitions="Auto,Auto,*">
                                      <Viewbox Grid.Row="0" MaxHeight="14" Stretch="Uniform" HorizontalAlignment="Center" IsVisible="{Binding ShowTitle}">
                                          <TextBlock Text="{Binding Title}" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" />
                                      </Viewbox>
                                      <Viewbox Grid.Row="1" MaxHeight="20" Stretch="Uniform" HorizontalAlignment="Center">
                                          <TextBlock Text="{Binding SliderValue, StringFormat=\{0:F0\}}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                                      </Viewbox>
                                      <Slider Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding SliderValue, Mode=TwoWay}" VerticalAlignment="Center" />
                                  </Grid>
                              </Border>
                              <!-- Design Overlay -->
                              <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
                                  <Grid ClipToBounds="False">
                                      <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                          <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                      </Border>
                                      <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                  </Grid>
                              </Border>
                          </Grid>
                      </DataTemplate>

                      <!-- SetValue -->
                      <DataTemplate DataType="{x:Type vm:SetValueViewModel}">
                          <Grid ClipToBounds="False">
                              <Border Background="{Binding ShowBorder, Converter={StaticResource BoolToBorderBg}}"
                                      BorderBrush="{Binding ShowBorder, Converter={StaticResource BoolToBorderStroke}}"
                                      BorderThickness="1" CornerRadius="6" Margin="1" Padding="0">
                                  <Button Command="{Binding InputSetpointCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="6" Background="#232325" Classes="hmi-compact">
                                      <Grid RowDefinitions="Auto,*" Margin="4,2">
                                          <Viewbox Grid.Row="0" MaxHeight="14" Stretch="Uniform" HorizontalAlignment="Center" IsVisible="{Binding ShowTitle}">
                                              <TextBlock Text="{Binding Title}" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" />
                                          </Viewbox>
                                          <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,0,0">
                                              <Grid ColumnDefinitions="*,Auto">
                                                  <Viewbox Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                      <TextBlock Text="{Binding DisplayValue}" Foreground="{Binding ValueColor, Converter={StaticResource HexToBrush}}" FontWeight="Bold" VerticalAlignment="Center" />
                                                  </Viewbox>
                                                  <TextBlock Grid.Column="1" Text="✏️" Foreground="#888" FontSize="10" VerticalAlignment="Center" Margin="2,0,0,0" />
                                              </Grid>
                                          </Border>
                                      </Grid>
                                  </Button>
                              </Border>
                              <!-- Design Overlay -->
                              <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
                                  <Grid ClipToBounds="False">
                                      <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                          <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                      </Border>
                                      <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                  </Grid>
                              </Border>
                          </Grid>
                      </DataTemplate>

                      <!-- RealTimeTrend -->
                      <DataTemplate DataType="{x:Type vm:RealTimeTrendViewModel}">
                          <Grid ClipToBounds="False">
                              <Border Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" Margin="1" Padding="6">
                                  <Grid RowDefinitions="Auto,*">
                                      <!-- Header with Live Value -->
                                      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                          <Viewbox Grid.Column="0" MaxHeight="14" Stretch="Uniform" HorizontalAlignment="Left">
                                              <TextBlock Text="{Binding Title}" Foreground="Gray" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                          </Viewbox>
                                          <Viewbox Grid.Column="1" MaxHeight="14" Stretch="Uniform" HorizontalAlignment="Right">
                                              <TextBlock Text="{Binding LatestValueDisplay}" Foreground="#00FFCC" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                          </Viewbox>
                                      </Grid>
                                      <!-- Trend Line Control -->
                                      <v:TrendLineControl Grid.Row="1" 
                                                          Values="{Binding Values}" 
                                                          MinY="{Binding MinY}" 
                                                          MaxY="{Binding MaxY}" />
                                  </Grid>
                              </Border>
                              <!-- Design Overlay -->
                              <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
                                  <Grid ClipToBounds="False">
                                      <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                          <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                      </Border>
                                      <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                  </Grid>
                              </Border>
                          </Grid>
                      </DataTemplate>

                       <!-- Pipe (Трубопровод) -->
                       <DataTemplate DataType="{x:Type vm:PipeWidgetViewModel}">
                           <Grid ClipToBounds="False">
                               <v:PipeControl Points="{Binding PipePoints, Mode=TwoWay}"
                                              ShowFlanges="{Binding ShowFlanges}"
                                              Thickness="{Binding Thickness}"
                                              StartFitting="{Binding StartFitting}"
                                              EndFitting="{Binding EndFitting}"
                                              IsDesignMode="{Binding ProjectContext.IsDesignMode}"
                                              IsEditingVertices="{Binding IsEditingVertices}"
                                              ActiveColor="{Binding ActiveColor}"
                                              InactiveColor="{Binding InactiveColor}"
                                              IsFilled="{Binding IsActive}"
                                              CellSize="{Binding $parent[v:DashboardPanel].CellWidth}" />
                               
                               <!-- Design Overlay -->
                               <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="Transparent" ZIndex="100" ClipToBounds="False">
                                   <Grid ClipToBounds="False">
                                   </Grid>
                               </Border>
                           </Grid>
                       </DataTemplate>

                       <!-- Valve (Клапан / Задвижка) -->
                       <DataTemplate DataType="{x:Type vm:ValveWidgetViewModel}">
                           <Grid ClipToBounds="False">
                               <Button Command="{Binding OpenControlPopupCommand}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Background="Transparent" BorderThickness="0" Padding="0"
                                       ClipToBounds="False">
                                   <Grid ClipToBounds="False" RowDefinitions="*,Auto">
                                       <!-- Valve Graphic filling the widget bounds -->
                                       <v:ValveControl Grid.Row="0"
                                           ValveType="{Binding ValveType}"
                                           IsOpen="{Binding IsOpen}"
                                           IsMoving="{Binding IsMoving}"
                                           IsSensorFault="{Binding IsSensorFault}"
                                           Setpoint="{Binding Setpoint}"
                                           Feedback="{Binding Feedback}"
                                           HasFeedbackSource="{Binding HasFeedbackSource}"
                                           IsVertical="{Binding IsVertical}"
                                           ActuatorType="{Binding ActuatorType}"
                                           ActiveColor="{Binding ActiveColor}"
                                           InactiveColor="{Binding InactiveColor}"
                                           Rotation="{Binding Rotation}"
                                           IsAlarmFlashing="{Binding IsAlarmFlashing}"
                                           IsAlarmFlashState="{Binding IsAlarmFlashState}"
                                           ShowStaticAlarmIcon="{Binding ShowStaticAlarmIcon}"
                                           ShowFeedbackBar="True" />

                                       <!-- Title and Value cleanly positioned without overflowing -->
                                       <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,1,0,0">
                                           <Viewbox MaxHeight="12" Stretch="Uniform" IsVisible="{Binding ShowTitle}">
                                               <TextBlock Text="{Binding Title}" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" />
                                           </Viewbox>
                                           <Viewbox MaxHeight="12" Stretch="Uniform" IsVisible="{Binding ShowStatusText}">
                                               <TextBlock Text="{Binding DisplayValue}" FontSize="11" FontWeight="Bold" Foreground="{Binding CurrentColor, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center" />
                                           </Viewbox>
                                       </StackPanel>
                                   </Grid>
                               </Button>

                               <!-- Design Overlay -->
                               <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
                                   <Grid ClipToBounds="False">
                                        <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                            <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                        </Border>
                                       <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                   </Grid>
                               </Border>
                           </Grid>
                       </DataTemplate>

                       <!-- Tank (Бак / Резервуар) -->
                       <DataTemplate DataType="{x:Type vm:TankWidgetViewModel}">
                           <Grid ClipToBounds="False">
                               <Border Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1.5" CornerRadius="6" Margin="1">
                                   <Grid RowDefinitions="Auto,*,Auto" Margin="2">
                                       <Viewbox Grid.Row="0" MaxHeight="13" Stretch="Uniform" HorizontalAlignment="Center" IsVisible="{Binding ShowTitle}">
                                           <TextBlock Text="{Binding Title}" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" />
                                       </Viewbox>
                                       
                                       <Grid Grid.Row="1" Margin="4,2">
                                           <Border Background="#151515" BorderBrush="#555" BorderThickness="1" CornerRadius="3">
                                               <Grid VerticalAlignment="Stretch">
                                                   <ProgressBar Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" Value="{Binding CurrentLevel}" 
                                                                Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                Background="Transparent" Foreground="#007ACC" BorderThickness="0" CornerRadius="0" />
                                               </Grid>
                                           </Border>
                                       </Grid>
                                       
                                       <Viewbox Grid.Row="2" MaxHeight="13" Stretch="Uniform" HorizontalAlignment="Center">
                                           <TextBlock Text="{Binding DisplayValue}" Foreground="{Binding ValueColor, Converter={StaticResource HexToBrush}}" FontSize="{Binding ValueFontSize}" FontWeight="Bold" HorizontalAlignment="Center" />
                                       </Viewbox>
                                   </Grid>
                               </Border>

                               <!-- Design Overlay -->
                               <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
                                   <Grid ClipToBounds="False">
                                        <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                            <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                        </Border>
                                       <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                   </Grid>
                               </Border>
                           </Grid>
                       </DataTemplate>

                       <!-- Pump (Насос) -->
                       <DataTemplate DataType="{x:Type vm:PumpWidgetViewModel}">
                           <Grid ClipToBounds="False">
                               <Button Command="{Binding OpenControlPopupCommand}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Background="Transparent" BorderThickness="0" Padding="0">
                                   <Border Background="#2B2B2B" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" Margin="1">
                                       <Grid RowDefinitions="*,Auto" Margin="2">
                                           <Viewbox Grid.Row="0" Margin="4">
                                               <Grid Width="50" Height="50">
                                                   <Ellipse Fill="#151515" Stroke="{Binding CurrentColor, Converter={StaticResource HexToBrush}}" StrokeThickness="2.5" />
                                                   <Path Data="M 25 5 L 25 45 M 5 25 L 45 25 M 10 10 L 40 40 M 10 40 L 40 10" 
                                                         Stroke="{Binding CurrentColor, Converter={StaticResource HexToBrush}}" StrokeThickness="1.5" />
                                                   <Ellipse Fill="{Binding CurrentColor, Converter={StaticResource HexToBrush}}" Width="10" Height="10" />
                                               </Grid>
                                           </Viewbox>
                                           
                                           <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,1,0,1">
                                               <Viewbox MaxHeight="12" Stretch="Uniform" IsVisible="{Binding ShowTitle}">
                                                   <TextBlock Text="{Binding Title}" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" />
                                               </Viewbox>
                                               <Viewbox MaxHeight="12" Stretch="Uniform">
                                                   <TextBlock Text="{Binding DisplayValue}" FontSize="11" FontWeight="Bold" Foreground="{Binding CurrentColor, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center" />
                                               </Viewbox>
                                           </StackPanel>
                                       </Grid>
                                   </Border>
                               </Button>

                               <!-- Design Overlay -->
                               <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
                                   <Grid ClipToBounds="False">
                                        <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                            <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                        </Border>
                                       <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                   </Grid>
                               </Border>
                           </Grid>
                       </DataTemplate>

                       <!-- HeatExchanger (Теплообменник) -->
                       <DataTemplate DataType="{x:Type vm:HeatExchangerWidgetViewModel}">
                           <Grid ClipToBounds="False">
                               <Border Background="#24262B" BorderBrush="#3E424B" BorderThickness="1.5" CornerRadius="8" Margin="3">
                                   <Grid RowDefinitions="Auto,*,Auto">
                                       <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,2" />
                                       <v:HeatExchangerControl Grid.Row="1"
                                                              ExchangerType="{Binding ExchangerType}"
                                                              PrimaryTemp="{Binding PrimaryTemp}"
                                                              SecondaryTemp="{Binding SecondaryTemp}"
                                                              ActiveColor="{Binding ActiveColor}"
                                                              InactiveColor="{Binding InactiveColor}"
                                                              ShowFlanges="{Binding ShowFlanges}"
                                                              Margin="6,2" />
                                       <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,2,0,4">
                                           <TextBlock Text="{Binding DisplayValue}" FontSize="12" FontWeight="Bold" Foreground="{Binding ActiveColor, Converter={StaticResource HexToBrush}}" />
                                           <TextBlock Text="{Binding SecondaryTemp, StringFormat=\{0:F1\} °C}" FontSize="11" Foreground="#FFA500" />
                                       </StackPanel>
                                   </Grid>
                               </Border>

                               <!-- Design Overlay -->
                               <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="8" Margin="3" ZIndex="100" ClipToBounds="False">
                                   <Grid ClipToBounds="False">
                                        <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                            <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                        </Border>
                                       <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                   </Grid>
                               </Border>
                           </Grid>
                       </DataTemplate>

                       <!-- Reactor (Реактор с мешалкой) -->
                       <DataTemplate DataType="{x:Type vm:ReactorWidgetViewModel}">
                           <Grid ClipToBounds="False">
                               <Button Command="{Binding ToggleAgitatorCommand}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Background="Transparent" BorderThickness="0" Padding="0">
                                   <Border Background="#24262B" BorderBrush="#3E424B" BorderThickness="1.5" CornerRadius="8" Margin="3">
                                       <Grid RowDefinitions="Auto,*,Auto">
                                           <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,2" />
                                           <v:ReactorControl Grid.Row="1"
                                                            Level="{Binding CurrentLevel}"
                                                            Temperature="{Binding Temperature}"
                                                            IsAgitatorRunning="{Binding IsAgitatorRunning}"
                                                            HasJacket="{Binding HasJacket}"
                                                            ActiveColor="{Binding ActiveColor}"
                                                            InactiveColor="{Binding InactiveColor}"
                                                            Margin="6,2" />
                                           <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,2,0,4">
                                               <TextBlock Text="{Binding DisplayValue}" FontSize="12" FontWeight="Bold" Foreground="{Binding ActiveColor, Converter={StaticResource HexToBrush}}" />
                                               <TextBlock Text="{Binding Temperature, StringFormat=\{0:F1\} °C}" FontSize="11" Foreground="#FFA500" />
                                           </StackPanel>
                                       </Grid>
                                   </Border>
                               </Button>

                               <!-- Design Overlay -->
                               <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="8" Margin="3" ZIndex="100" ClipToBounds="False">
                                   <Grid ClipToBounds="False">
                                        <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                            <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                        </Border>
                                       <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                   </Grid>
                               </Border>
                           </Grid>
                       </DataTemplate>

                       <!-- LevelSensor (Датчик уровня LT) -->
                       <DataTemplate DataType="{x:Type vm:LevelSensorWidgetViewModel}">
                           <Grid ClipToBounds="False">
                               <Border Background="#24262B" BorderBrush="#3E424B" BorderThickness="1.5" CornerRadius="8" Margin="3">
                                   <Grid RowDefinitions="Auto,*,Auto">
                                       <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,2" />
                                       <v:LevelSensorControl Grid.Row="1"
                                                            Value="{Binding CurrentValue}"
                                                            TagNumber="{Binding TagNumber}"
                                                            SensorType="{Binding SensorType}"
                                                            Unit="{Binding Unit}"
                                                            MinValue="{Binding MinValue}"
                                                            MaxValue="{Binding MaxValue}"
                                                            AlarmHigh="{Binding AlarmHigh}"
                                                            AlarmLow="{Binding AlarmLow}"
                                                            Margin="4,2" />
                                       <TextBlock Grid.Row="2" Text="{Binding DisplayValue}" FontSize="12" FontWeight="Bold" Foreground="{Binding ValueColor, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center" Margin="0,2,0,4" />
                                   </Grid>
                               </Border>

                               <!-- Design Overlay -->
                               <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="8" Margin="3" ZIndex="100" ClipToBounds="False">
                                   <Grid ClipToBounds="False">
                                        <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                            <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                        </Border>
                                       <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                   </Grid>
                               </Border>
                           </Grid>
                       </DataTemplate>

                      <!-- Fallback WidgetViewModelBase -->
                      <DataTemplate DataType="{x:Type vm:WidgetViewModelBase}">
                          <Grid ClipToBounds="False">
                              <Border Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="8" Margin="5">
                                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                      <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" />
                                      <TextBlock Text="{Binding Type}" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" />
                                  </StackPanel>
                              </Border>
                              <!-- Design Overlay -->
                              <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="8" Margin="5" ZIndex="100" ClipToBounds="False">
                                  <Grid ClipToBounds="False">
                                        <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                                            <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                                        </Border>
                                      <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
                                  </Grid>
                              </Border>
                          </Grid>
                      </DataTemplate>
                   </ItemsControl.DataTemplates>
              </ItemsControl>
              <v:SelectionOverlay x:Name="DashboardSelectionOverlay" Margin="10" IsHitTestVisible="False" ClipToBounds="False" />
          </Grid>
             </LayoutTransformControl>
         </ScrollViewer>

        <!-- Floating Unified Control Toolbar (Visible only in Design Mode) -->
        <Border IsVisible="{Binding ProjectContext.IsDesignMode}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="20,0,90,20" Padding="10,6"
                Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1"
                CornerRadius="8" BoxShadow="0 4 12 0 #90000000" ZIndex="1000">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Zoom Controls -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,2,6,2">
                    <TextBlock Text="Масштаб:" Foreground="Gray" VerticalAlignment="Center" FontSize="12" />
                    <Slider Minimum="0.5" Maximum="3.0" Value="{Binding ZoomScale, Mode=TwoWay}" Width="100" Height="24" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ZoomScale, StringFormat=\{0:P0\}}" Foreground="White" Width="40" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                    <Button Content="100%" Command="{Binding ResetZoomCommand}" FontSize="11" Padding="6,3" Background="#4A4A4D" Foreground="White" CornerRadius="4" VerticalAlignment="Center">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#5A5A5D" />
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>

                <!-- Divider -->
                <Border Width="1" Background="#3E3E42" Height="16" Margin="2,0,8,0" VerticalAlignment="Center" />

                <!-- Multiselect toggle -->
                <ToggleButton IsChecked="{Binding IsMultiSelectMode, Mode=TwoWay}"
                              ToolTip.Tip="Режим мультивыбора (для кликов без зажатия Ctrl)"
                              Padding="8,4" FontSize="11" CornerRadius="4"
                              Background="#3A3A3D" Foreground="#CCCCCC"
                              Margin="0,2,6,2" VerticalAlignment="Center">
                    <ToggleButton.Styles>
                        <Style Selector="ToggleButton:checked">
                            <Setter Property="Background" Value="#0E4A8E" />
                            <Setter Property="Foreground" Value="#00E5FF" />
                        </Style>
                        <Style Selector="ToggleButton:pointerover">
                            <Setter Property="Background" Value="#4E4E52" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                        <Style Selector="ToggleButton:checked:pointerover">
                            <Setter Property="Background" Value="#1565C0" />
                            <Setter Property="Foreground" Value="#80D8FF" />
                        </Style>
                    </ToggleButton.Styles>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🗂️" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Мультивыбор" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <!-- Selection Context Tools (Visible only when multiple items are selected) -->
                <!-- 1. Selection Info Badge -->
                <Border IsVisible="{Binding HasMultiSelection}"
                        Background="#202023" BorderBrush="#007ACC" BorderThickness="1"
                        CornerRadius="4" Padding="6,3" Margin="2,2,8,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🗂️" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedWidgetsCount, StringFormat='Выделено: {0}'}" 
                                   FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" FontSize="11" />
                        <TextBlock Text="{Binding SelectedWidgetsSummary}" 
                                   Foreground="#CCCCCC" VerticalAlignment="Center" FontSize="11" MaxWidth="180" 
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedWidgetsSummary}" />
                    </StackPanel>
                </Border>

                <!-- 2. Alignment Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                            IsVisible="{Binding HasMultiSelection}" Margin="0,2,8,2">
                    <StackPanel.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#4E4E52" />
                        </Style>
                    </StackPanel.Styles>
                    <Button Command="{Binding AlignLeftCommand}" ToolTip.Tip="Выровнять по левому краю" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="⇤" FontSize="13" Foreground="White" />
                    </Button>
                    <Button Command="{Binding AlignCenterHorizontalCommand}" ToolTip.Tip="Выровнять по горизонтальному центру" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="⬌" FontSize="11" Foreground="White" />
                    </Button>
                    <Button Command="{Binding AlignRightCommand}" ToolTip.Tip="Выровнять по правому краю" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="⇥" FontSize="13" Foreground="White" />
                    </Button>
                    <Button Command="{Binding AlignTopCommand}" ToolTip.Tip="Выровнять по верхнему краю" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="⇪" FontSize="13" Foreground="White" />
                    </Button>
                    <Button Command="{Binding AlignCenterVerticalCommand}" ToolTip.Tip="Выровнять по вертикальному центру" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="⬍" FontSize="11" Foreground="White" />
                    </Button>
                    <Button Command="{Binding AlignBottomCommand}" ToolTip.Tip="Выровнять по нижнему краю" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="⇩" FontSize="13" Foreground="White" />
                    </Button>
                </StackPanel>

                <!-- 3. Distribution Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                            IsVisible="{Binding HasMultiSelection}" Margin="0,2,8,2">
                    <StackPanel.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#4E4E52" />
                        </Style>
                    </StackPanel.Styles>
                    <Button Command="{Binding DistributeHorizontallyCommand}" ToolTip.Tip="Распределить равномерно по горизонтали" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="↔" FontSize="13" Foreground="White" />
                    </Button>
                    <Button Command="{Binding DistributeVerticallyCommand}" ToolTip.Tip="Распределить равномерно по вертикали" Padding="5,3" FontSize="11" Background="#3A3A3D" CornerRadius="3">
                        <TextBlock Text="↕" FontSize="13" Foreground="White" />
                    </Button>
                </StackPanel>

                <!-- 4. Group & Ungroup -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            IsVisible="{Binding HasMultiSelection}" Margin="0,2,8,2">
                    <Button Command="{Binding GroupSelectedWidgetsCommand}" 
                            IsEnabled="{Binding CanGroup}"
                            ToolTip.Tip="Сгруппировать выбранные объекты (единый узел)"
                            Padding="6,3" FontSize="11" Background="#334D66" CornerRadius="3">
                        <TextBlock Text="🔗 Группа" FontSize="11" Foreground="#00E5FF" />
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#3D5C7A" />
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Command="{Binding UngroupSelectedWidgetsCommand}" 
                            IsEnabled="{Binding CanUngroup}"
                            ToolTip.Tip="Разгруппировать объекты"
                            Padding="6,3" FontSize="11" Background="#4D3333" CornerRadius="3">
                        <TextBlock Text="🔓 Разгрупп." FontSize="11" Foreground="#FF8A80" />
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#5C3D3D" />
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>

                <!-- 5. Actions: Duplicate, Delete group, Clear selection -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            IsVisible="{Binding HasMultiSelection}" Margin="0,2,0,2">
                    <Button Command="{Binding DuplicateSelectedWidgetsCommand}" 
                            ToolTip.Tip="Дублировать группу (Ctrl+D)"
                            Padding="6,3" FontSize="11" Background="#384A38" CornerRadius="3" VerticalAlignment="Center">
                        <TextBlock Text="📋 Дублировать" FontSize="11" Foreground="#69F0AE" />
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#435C43" />
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Command="{Binding RemoveSelectedWidgetsCommand}" 
                            ToolTip.Tip="Удалить группу (Delete)"
                            Padding="6,3" FontSize="11" Background="#C62828" Foreground="White" CornerRadius="3" VerticalAlignment="Center">
                        <TextBlock Text="🗑️ Удалить группу" FontSize="11" Foreground="White" />
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#E53935" />
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button Command="{Binding ClearSelectionCommand}" 
                            ToolTip.Tip="Снять выделение (Esc)"
                            Padding="6,3" FontSize="11" Background="#3E3E42" Foreground="#CCCCCC" CornerRadius="3" VerticalAlignment="Center">
                        <TextBlock Text="✖ Снять" FontSize="11" />
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#4E4E52" />
                                <Setter Property="Foreground" Value="White" />
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Border>

         <!-- Global Add Widget Button (Visible only in Design Mode) -->
         <Button IsVisible="{Binding ProjectContext.IsDesignMode}" 
                 Content="+" 
                 FontSize="24" FontWeight="Bold"
                 Foreground="White" Background="#007ACC"
                 Width="56" Height="56" CornerRadius="28"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="20" ZIndex="1000"
                 Command="{Binding AddWidgetCommand}">
             <Button.Styles>
                 <Style Selector="Button:pointerover">
                     <Setter Property="Background" Value="#005A9E"/>
                 </Style>
             </Button.Styles>
         </Button>
     </Grid>
 </UserControl>