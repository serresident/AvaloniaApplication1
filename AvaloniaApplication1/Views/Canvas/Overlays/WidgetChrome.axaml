<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmCore="clr-namespace:AvaloniaApplication1.ViewModels.Core"
             xmlns:overlays="clr-namespace:AvaloniaApplication1.Views.Canvas.Overlays"
             xmlns:c="clr-namespace:AvaloniaApplication1.Converters"
             x:Class="AvaloniaApplication1.Views.Canvas.Overlays.WidgetChrome"
             x:DataType="vmCore:WidgetViewModelBase"
             x:CompileBindings="True"
             ClipToBounds="False">
    <UserControl.Resources>
        <c:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.widget-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.widget-card.has-border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid ClipToBounds="False">
        <Border Classes="widget-card"
                Classes.has-border="{Binding ShowBorder}"
                BorderThickness="1" CornerRadius="6" Margin="1"
                Padding="{Binding CardPadding, RelativeSource={RelativeSource AncestorType=overlays:WidgetChrome}}">
            <ContentPresenter Content="{Binding InnerContent, RelativeSource={RelativeSource AncestorType=overlays:WidgetChrome}}" />
        </Border>

        <!-- Quality Glyph Badge (Overridden [M], Stale ⏳, CommFailure ⚠️) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4,2"
                IsVisible="{Binding QualityGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#CC1E1E1E" CornerRadius="3" Padding="3,1" ZIndex="50" IsHitTestVisible="False">
            <TextBlock Text="{Binding QualityGlyph}" Foreground="{Binding QualityGlyphColor, Converter={StaticResource HexToBrush}}"
                       FontSize="10" FontWeight="Bold" />
        </Border>

        <!-- Design Overlay -->
        <Border IsVisible="{Binding IsSelected}" Name="DragHandle" Background="{x:Null}" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="6" Margin="1" ZIndex="100" ClipToBounds="False">
            <Grid ClipToBounds="False">
                <Border Height="18" VerticalAlignment="Top" Background="#DD0E2A47" CornerRadius="4,4,0,0">
                    <TextBlock Text="⋮⋮" Foreground="#88FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False" />
                </Border>
                <TextBlock Text="◢" Foreground="#007ACC" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
