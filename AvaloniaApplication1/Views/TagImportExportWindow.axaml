<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels"
        mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="550"
        x:Class="AvaloniaApplication1.Views.TagImportExportWindow"
        x:DataType="vm:TagImportExportViewModel"
        x:CompileBindings="True"
        Title="{Binding WindowTitle}"
        Width="750" Height="550"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="16">

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding WindowTitle}"
                   Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

        <!-- Format & Clipboard Controls -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
            <!-- Format Choice -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <Button Content="CSV (Excel / PLC)" Command="{Binding SelectCsvFormatCommand}"
                        Background="#2D2D30" Foreground="White" CornerRadius="4" Padding="10,6" FontSize="12" />
                <Button Content="JSON (SCADA)" Command="{Binding SelectJsonFormatCommand}"
                        Background="#2D2D30" Foreground="White" CornerRadius="4" Padding="10,6" FontSize="12" />
            </StackPanel>

            <!-- Clipboard Quick Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Content="📋 Скопировать всё" Command="{Binding CopyToClipboardCommand}"
                        Background="#3E3E42" Foreground="White" CornerRadius="4" Padding="10,6" FontSize="12" />
                <Button Content="📥 Вставить из буфера" Command="{Binding PasteFromClipboardCommand}"
                        Background="#3E3E42" Foreground="White" CornerRadius="4" Padding="10,6" FontSize="12"
                        IsVisible="{Binding IsImportMode}" />
            </StackPanel>
        </Grid>

        <!-- Main Content Text Area -->
        <Border Grid.Row="2" Background="#252526" CornerRadius="6" BorderBrush="#3F3F46" BorderThickness="1">
            <TextBox Text="{Binding ContentText}"
                     FontFamily="Consolas, monospace" FontSize="12"
                     AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap"
                     Background="Transparent" Foreground="#DCDCAA"
                     BorderThickness="0" Padding="8" />
        </Border>

        <!-- Status Message Banner -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                   Foreground="#00E5FF" FontSize="12" Margin="0,6,0,0"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Footer Buttons -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Background="#3E3E42" Foreground="White"
                    CornerRadius="6" Padding="16,8" FontSize="13"
                    HorizontalAlignment="Left" />

            <Button Grid.Column="1" Content="✓ Применить импорт"
                    Command="{Binding ApplyImportCommand}"
                    Background="#008A00" Foreground="White"
                    CornerRadius="6" Padding="20,8" FontSize="13" FontWeight="SemiBold"
                    HorizontalAlignment="Right"
                    IsVisible="{Binding IsImportMode}" />

            <Button Grid.Column="1" Content="Закрыть"
                    Command="{Binding CancelCommand}"
                    Background="#007ACC" Foreground="White"
                    CornerRadius="6" Padding="20,8" FontSize="13" FontWeight="SemiBold"
                    HorizontalAlignment="Right"
                    IsVisible="{Binding !IsImportMode}" />
        </Grid>

    </Grid>
</Window>
