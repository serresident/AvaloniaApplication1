<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels.Windows.Common"
        xmlns:models="clr-namespace:AvaloniaApplication1.Models"
        xmlns:scada="https://github.com/avaloniaapplication1/controls"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="700"
        x:Class="AvaloniaApplication1.Views.Windows.Common.WidgetEditorWindow"
        x:DataType="vm:WidgetEditorViewModel"
        Title="Свойства контрола"
        Icon="{x:Null}"
        Width="440" Height="600"
        MinWidth="400" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        CanResize="True">

    <Grid RowDefinitions="*,Auto">

        <!-- Scrollable content area -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" ClipToBounds="True" Padding="20,20,20,80">
            <StackPanel Spacing="12">

                <!-- Header -->
                <TextBlock Text="Свойства виджета мнемосхемы" Foreground="{DynamicResource ThemeForegroundBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />

                <!-- Widget Type -->
                <TextBlock Text="Тип виджета" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12" />
                <ComboBox ItemsSource="{Binding AvailableWidgetTypes}" 
                          SelectedItem="{Binding SelectedWidgetType}"
                          HorizontalAlignment="Stretch" />

                <!-- Title -->
                <TextBlock Text="Наименование / Заголовок" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="12" />
                <TextBox Text="{Binding Title}" PlaceholderText="Заголовок или тег виджета..." />

                <!-- Typography & Display Section -->
                <Border Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Отображение и типографика" Foreground="{DynamicResource ThemeAccentBrush}" FontSize="14" FontWeight="SemiBold" />
                        
                        <Grid ColumnDefinitions="*,10,*">
                            <CheckBox Grid.Column="0" Content="Показывать заголовок" IsChecked="{Binding ShowTitle}" Foreground="{DynamicResource ThemeForegroundBrush}" />
                            <CheckBox Grid.Column="2" Content="Показывать рамку" IsChecked="{Binding ShowBorder}" Foreground="{DynamicResource ThemeForegroundBrush}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,10,*">
                            <CheckBox Grid.Column="0" Content="Автомасштаб текста" IsChecked="{Binding AutoScaleText}" Foreground="{DynamicResource ThemeForegroundBrush}" />
                            <CheckBox Grid.Column="2" Content="Компактный режим" IsChecked="{Binding CompactMode}" Foreground="{DynamicResource ThemeForegroundBrush}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Размер шрифта (0 = авто)" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" />
                                <NumericUpDown Value="{Binding CustomFontSize}" Minimum="0" Maximum="72" FormatString="0 px" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Положение подписи" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" />
                                <ComboBox ItemsSource="{Binding AvailableLabelPositions}"
                                          SelectedItem="{Binding SelectedLabelPosition}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Position Section -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Позиция и размеры (сетка)" Foreground="#00AAFF" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,8,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Строка (Row / Y)" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding Row}" Minimum="0" Maximum="100" FormatString="0" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Колонка (Col / X)" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding Col}" Minimum="0" Maximum="100" FormatString="0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Ширина (ячеек)" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding SizeX}" Minimum="1" Maximum="100" FormatString="0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Высота (ячеек)" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding SizeY}" Minimum="1" Maximum="100" FormatString="0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Data Source Section -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Источник данных (Связь с ПЛК / Тэг)" Foreground="#00AAFF" FontSize="14" FontWeight="SemiBold" />
                        
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Тег из базы TagManager (Rapid SCADA)" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="🏷️ Выбрать из базы..." Command="{Binding BrowseTagsCommand}"
                                    Background="#0E639C" Foreground="White" CornerRadius="4" Padding="8,3" FontSize="11" FontWeight="SemiBold"
                                    ToolTip.Tip="Открыть браузер тегов для выбора сигнала в 1 клик с автоподтягиванием единиц и формата" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding AvailableTags}" 
                                  SelectedItem="{Binding SelectedTag}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="-- Выберите тег из базы --">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TagDefinition">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding TagId}" FontFamily="Consolas, monospace" Foreground="#9CDCFE" FontWeight="SemiBold" />
                                        <TextBlock Text="—" Foreground="#666666" />
                                        <TextBlock Text="{Binding Name}" Foreground="White" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Подключение (Драйвер)" Foreground="#AAAAAA" FontSize="11" />
                        <ComboBox ItemsSource="{Binding AvailableConnections}" 
                                  SelectedItem="{Binding SelectedConnectionId}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Выберите подключение..." />

                        <TextBlock Text="Адрес тэга (регистр / топик MQTT)" Foreground="#AAAAAA" FontSize="11" />
                        <TextBox Text="{Binding Address}" PlaceholderText="напр. 40001, 10001 или /devices/wb-mwac/controls/K1" />

                        <TextBlock Text="Тип данных тэга" Foreground="#AAAAAA" FontSize="11" />
                        <ComboBox ItemsSource="{Binding AvailableDataTypes}" 
                                  SelectedItem="{Binding SelectedDataType}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <!-- ValueDisplay Settings -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4"
                        IsVisible="{Binding ShowValueDisplaySettings}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Настройки отображения значения" Foreground="#FFD700" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Формат вывода числа / строки" Foreground="#AAAAAA" FontSize="11" />
                        <scada:FormatEditorBox Format="{Binding Format}" />

                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Цвет текста значения" Foreground="#AAAAAA" FontSize="11" />
                                <scada:ColorPickerBox SelectedColorHex="{Binding ValueColor}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Размер шрифта значения" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding ValueFontSize}" Minimum="8" Maximum="120" FormatString="F0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PilotLight Settings -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4"
                        IsVisible="{Binding ShowPilotLightSettings}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Настройки индикатора (Pilot Light)" Foreground="#FFD700" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Цвет «ИСТИНА / ВКЛ»" Foreground="#AAAAAA" FontSize="11" />
                                <scada:ColorPickerBox SelectedColorHex="{Binding TrueColor}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Цвет «ЛОЖЬ / ВЫКЛ»" Foreground="#AAAAAA" FontSize="11" />
                                <scada:ColorPickerBox SelectedColorHex="{Binding FalseColor}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CommandButton Settings -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4"
                        IsVisible="{Binding ShowCommandButtonSettings}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Настройки кнопки управления" Foreground="#FFD700" FontSize="14" FontWeight="SemiBold" />

                        <TextBlock Text="Режим кнопки" Foreground="#AAAAAA" FontSize="11" />
                        <ComboBox ItemsSource="{Binding AvailableButtonModes}"
                                  SelectedItem="{Binding SelectedButtonMode}"
                                  HorizontalAlignment="Stretch" />

                        <!-- Mode description -->
                        <Border Background="#1A1A1A" CornerRadius="4" Padding="8,4">
                            <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap">
                                Toggle — обычный тумблер (ВКЛ/ВЫКЛ). Momentary — импульс пока нажата. Latching — кнопка с фиксацией (Пуск/Стоп). ToggleSwitch — визуальный переключатель.
                            </TextBlock>
                        </Border>

                        <!-- ToggleSwitch Style & Orientation -->
                        <Border Background="#252528" CornerRadius="6" Padding="10,8" Margin="0,2"
                                IsVisible="{Binding IsToggleSwitchSelected}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Параметры переключателя (ToggleSwitch)" Foreground="#00AAFF" FontSize="12" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,10,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Стиль переключателя" Foreground="#AAAAAA" FontSize="11" />
                                        <ComboBox ItemsSource="{Binding AvailableSwitchStyles}"
                                                  SelectedItem="{Binding SelectedSwitchStyle}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ориентация" Foreground="#AAAAAA" FontSize="11" />
                                        <ComboBox ItemsSource="{Binding AvailableOrientations}"
                                                  SelectedItem="{Binding SelectedOrientation}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="Запрашивать подтверждение переключения"
                                          IsChecked="{Binding RequireConfirmation}"
                                          Foreground="White" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Separator Background="#3E3E42" Height="1" Margin="0,4" />

                        <!-- Labels -->
                        <TextBlock Text="Надпись ВКЛ / Активно" Foreground="#00AAFF" FontSize="12" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Надпись активного состояния" Foreground="#AAAAAA" FontSize="11" />
                                <TextBox Text="{Binding LabelOn}" PlaceholderText="ВКЛ / ПУСК" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Надпись неактивного состояния" Foreground="#AAAAAA" FontSize="11" />
                                <TextBox Text="{Binding LabelOff}" PlaceholderText="ВЫКЛ / СТОП" />
                            </StackPanel>
                        </Grid>

                        <Separator Background="#3E3E42" Height="1" Margin="0,4" />

                        <!-- Colors -->
                        <TextBlock Text="Цвета состояний" Foreground="#00AAFF" FontSize="12" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Цвет ВКЛ / Активно" Foreground="#AAAAAA" FontSize="11" />
                                <scada:ColorPickerBox SelectedColorHex="{Binding ColorOn}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Цвет ВЫКЛ / Неактивно" Foreground="#AAAAAA" FontSize="11" />
                                <scada:ColorPickerBox SelectedColorHex="{Binding ColorOff}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Slider Settings -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4"
                        IsVisible="{Binding ShowSliderSettings}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Настройки шкалы и диапазона" Foreground="#FFD700" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Мин. значение" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding MinValue}" FormatString="F1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Макс. значение" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding MaxValue}" FormatString="F1" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RealTimeTrend Multi-Pen & SCADA Settings -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4"
                        IsVisible="{Binding ShowTrendSettings}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📈 Настройки промышленного тренда (ISA-101)" Foreground="#00FFCC" FontSize="14" FontWeight="SemiBold" />

                        <!-- Scaling Mode & Time Window -->
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Режим шкалы Y" Foreground="#AAAAAA" FontSize="11" />
                                <ComboBox ItemsSource="{Binding AvailableScalingModes}"
                                          SelectedItem="{Binding TrendScalingMode}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Окно времени (сек)" Foreground="#AAAAAA" FontSize="11" />
                                <ComboBox ItemsSource="{Binding AvailableTimeWindows}"
                                          SelectedItem="{Binding TrendTimeWindowSeconds}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- Setpoint (SP) -->
                        <CheckBox IsChecked="{Binding TrendShowSetpoint}" Content="Отображать уставку (SP)" Foreground="#DDDDDD" FontSize="12" />
                        <Grid ColumnDefinitions="*,10,*" IsVisible="{Binding TrendShowSetpoint}">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Значение уставки" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding TrendSetpointValue}" FormatString="F1" />
                            </StackPanel>
                        </Grid>

                        <!-- Warning Limits (H/L) -->
                        <CheckBox IsChecked="{Binding TrendShowWarningLimits}" Content="Предупредительные границы (Warning H/L)" Foreground="#DDDDDD" FontSize="12" />
                        <Grid ColumnDefinitions="*,10,*" IsVisible="{Binding TrendShowWarningLimits}">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Warning High" Foreground="#FFD700" FontSize="11" />
                                <NumericUpDown Value="{Binding TrendWarningHigh}" FormatString="F1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Warning Low" Foreground="#FFD700" FontSize="11" />
                                <NumericUpDown Value="{Binding TrendWarningLow}" FormatString="F1" />
                            </StackPanel>
                        </Grid>

                        <!-- Alarm Limits (HH/LL) -->
                        <CheckBox IsChecked="{Binding TrendShowAlarmLimits}" Content="Аварийные границы (Alarm HH/LL)" Foreground="#DDDDDD" FontSize="12" />
                        <Grid ColumnDefinitions="*,10,*" IsVisible="{Binding TrendShowAlarmLimits}">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Alarm High" Foreground="#FF4444" FontSize="11" />
                                <NumericUpDown Value="{Binding TrendAlarmHigh}" FormatString="F1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Alarm Low" Foreground="#FF4444" FontSize="11" />
                                <NumericUpDown Value="{Binding TrendAlarmLow}" FormatString="F1" />
                            </StackPanel>
                        </Grid>

                        <!-- Legend & Crosshair Options -->
                        <TextBlock Text="Параметры отображения" Foreground="#AAAAAA" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding TrendEnableCrosshair}" Content="Визир (Crosshair)" Margin="0,0,12,4" Foreground="#DDDDDD" FontSize="12" />
                            <CheckBox IsChecked="{Binding TrendShowLegendTable}" Content="Таблица легенды" Margin="0,0,12,4" Foreground="#DDDDDD" FontSize="12" />
                            <CheckBox IsChecked="{Binding TrendShowLegendLatestValue}" Content="Текущее" Margin="0,0,12,4" Foreground="#DDDDDD" FontSize="12" />
                            <CheckBox IsChecked="{Binding TrendShowLegendMinMax}" Content="Мин/Макс" Margin="0,0,12,4" Foreground="#DDDDDD" FontSize="12" />
                            <CheckBox IsChecked="{Binding TrendShowLegendUnits}" Content="Ед. изм." Margin="0,0,12,4" Foreground="#DDDDDD" FontSize="12" />
                        </WrapPanel>

                        <Separator Background="#444444" Height="1" Margin="0,4" />

                        <!-- Pens Management -->
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="Каналы / Перья (до 8)" Foreground="#00FFCC" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding AddTrendPenCommand}" Content="＋ Добавить" Background="#007ACC" Foreground="White" Padding="8,4" CornerRadius="4" Margin="0,0,6,0" FontSize="11" />
                            <Button Grid.Column="2" Command="{Binding RemoveTrendPenCommand}" Content="✕ Удалить" Background="#AA3333" Foreground="White" Padding="8,4" CornerRadius="4" FontSize="11" />
                        </Grid>

                        <!-- Pens Selector Tabs / List -->
                        <ListBox ItemsSource="{Binding TrendPens}"
                                 SelectedItem="{Binding SelectedTrendPen}"
                                 Background="#252526"
                                 CornerRadius="4"
                                 MaxHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrendPenEditModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Grid.Column="0" Width="14" Height="14" CornerRadius="3" Background="{Binding ColorHex}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding YAxisBinding}" Foreground="#888888" FontSize="10" Margin="4,0" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="3" IsChecked="{Binding IsVisible}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Selected Pen Detailed Editor -->
                        <Border Background="#222224" CornerRadius="4" Padding="8" Margin="0,4"
                                IsVisible="{Binding SelectedTrendPen, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="6" x:DataType="vm:TrendPenEditModel" DataContext="{Binding SelectedTrendPen}">
                                <Grid ColumnDefinitions="*,10,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Название пера" Foreground="#AAAAAA" FontSize="10" />
                                        <TextBox Text="{Binding Name}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Цвет пера" Foreground="#AAAAAA" FontSize="10" />
                                        <scada:ColorPickerBox SelectedColorHex="{Binding ColorHex}" />
                                    </StackPanel>
                                </Grid>

                                <!-- TagManager & Data Source for Pen -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                    <TextBlock Grid.Column="0" Text="Тег из базы TagManager" Foreground="#AAAAAA" FontSize="10" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="🏷️ Выбрать тег..." 
                                            Command="{Binding $parent[Window].((vm:WidgetEditorViewModel)DataContext).BrowsePenTagCommand}"
                                            Background="#0E639C" Foreground="White" CornerRadius="4" Padding="6,2" FontSize="10" FontWeight="SemiBold"
                                            ToolTip.Tip="Выбрать сигнал из базы TagManager для пера" />
                                </Grid>
                                <ComboBox ItemsSource="{Binding $parent[Window].((vm:WidgetEditorViewModel)DataContext).AvailableTags}"
                                          SelectedItem="{Binding $parent[Window].((vm:WidgetEditorViewModel)DataContext).SelectedPenTag}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="-- Выберите тег из базы --"
                                          FontSize="11">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TagDefinition">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding TagId}" FontFamily="Consolas, monospace" Foreground="#9CDCFE" FontWeight="SemiBold" FontSize="10" />
                                                <TextBlock Text="—" Foreground="#666666" FontSize="10" />
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Grid ColumnDefinitions="*,10,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Подключение (ConnId)" Foreground="#AAAAAA" FontSize="10" />
                                        <ComboBox ItemsSource="{Binding $parent[Window].((vm:WidgetEditorViewModel)DataContext).AvailableConnections}"
                                                  SelectedItem="{Binding SelectedConnId}"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="Выберите..."
                                                  FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Адрес тега (Address)" Foreground="#AAAAAA" FontSize="10" />
                                        <TextBox Text="{Binding Address}" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,10,*,10,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ось Y" Foreground="#AAAAAA" FontSize="10" />
                                        <ComboBox ItemsSource="{Binding AvailableYAxisBindings}"
                                                  SelectedItem="{Binding YAxisBinding}"
                                                  HorizontalAlignment="Stretch" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Интерполяция" Foreground="#AAAAAA" FontSize="10" />
                                        <ComboBox ItemsSource="{Binding AvailableInterpolationModes}"
                                                  SelectedItem="{Binding InterpolationMode}"
                                                  HorizontalAlignment="Stretch" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Стиль линии" Foreground="#AAAAAA" FontSize="10" />
                                        <ComboBox ItemsSource="{Binding AvailableStrokeStyles}"
                                                  SelectedItem="{Binding StrokeStyle}"
                                                  HorizontalAlignment="Stretch" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,10,*,10,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Мин Y" Foreground="#AAAAAA" FontSize="10" />
                                        <NumericUpDown Value="{Binding MinValue}" FormatString="F1" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Макс Y" Foreground="#AAAAAA" FontSize="10" />
                                        <NumericUpDown Value="{Binding MaxValue}" FormatString="F1" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Толщина (px)" Foreground="#AAAAAA" FontSize="10" />
                                        <NumericUpDown Value="{Binding Thickness}" Minimum="1" Maximum="8" FormatString="0 px" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,10,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Единицы (Units)" Foreground="#AAAAAA" FontSize="10" />
                                        <TextBox Text="{Binding Units}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Формат числа" Foreground="#AAAAAA" FontSize="10" />
                                        <TextBox Text="{Binding Format}" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox IsChecked="{Binding AutoScale}" Content="Автомасштабирование (Full Dynamic)" Foreground="#DDDDDD" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Pipe Settings -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4"
                        IsVisible="{Binding ShowPipeSettings}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Параметры трубопровода" Foreground="#FFD700" FontSize="14" FontWeight="SemiBold" />
                        
                        <TextBlock Text="Узловые точки сетки (напр. 0,0;5,0;5,3)" Foreground="#AAAAAA" FontSize="11" />
                        <TextBox Text="{Binding PipePoints}" PlaceholderText="0,0;5,0;5,3" />

                        <TextBlock Text="Толщина трубы (px)" Foreground="#AAAAAA" FontSize="11" />
                        <NumericUpDown Value="{Binding Thickness}" Minimum="4" Maximum="32" FormatString="0 px" />

                        <TextBlock Text="Фитинг начала" Foreground="#AAAAAA" FontSize="11" />
                        <ComboBox ItemsSource="{Binding AvailableFittings}" 
                                  SelectedItem="{Binding SelectedStartFitting}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Text="Фитинг окончания" Foreground="#AAAAAA" FontSize="11" />
                        <ComboBox ItemsSource="{Binding AvailableFittings}" 
                                  SelectedItem="{Binding SelectedEndFitting}"
                                  HorizontalAlignment="Stretch" />
                        
                        <CheckBox Content="Отображать соединительные фланцы" IsChecked="{Binding ShowFlanges}" Foreground="White" />
                    </StackPanel>
                </Border>

                <!-- Valve Settings -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4"
                        IsVisible="{Binding ShowValveSettings}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Параметры задвижки / клапана" Foreground="#FFD700" FontSize="14" FontWeight="SemiBold" />
                        
                        <TextBlock Text="Тип клапана (Отсечной / Регулирующий)" Foreground="#AAAAAA" FontSize="11" />
                        <ComboBox ItemsSource="{Binding AvailableValveTypes}" 
                                  SelectedItem="{Binding SelectedValveType}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Text="Тип привода" Foreground="#AAAAAA" FontSize="11" />
                        <ComboBox ItemsSource="{Binding AvailableActuatorTypes}" 
                                  SelectedItem="{Binding SelectedActuatorType}"
                                  HorizontalAlignment="Stretch" />

                        <Grid ColumnDefinitions="*,10,*">
                            <CheckBox Grid.Column="0" Content="Вертикальная ориентация" IsChecked="{Binding IsVertical}" Foreground="White" />
                            <CheckBox Grid.Column="2" Content="Показ текста статуса" IsChecked="{Binding ShowStatusText}" Foreground="White" />
                        </Grid>

                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Угол поворота (°)" Foreground="#AAAAAA" FontSize="11" />
                                <ComboBox ItemsSource="{Binding AvailableRotations}" 
                                          SelectedItem="{Binding SelectedRotation}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Смещение подписи (px)" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding LabelOffset}" Minimum="-50" Maximum="50" FormatString="0 px" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Valve Feedback & Limit Switches Settings -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4"
                        IsVisible="{Binding ShowRegulatingSettings}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Обратная связь и концевые выключатели" Foreground="#FFD700" FontSize="14" FontWeight="SemiBold" />
                        
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Концевик «Открыт» / Положение (SQH / FB)" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="🏷️ Выбрать..." Command="{Binding BrowseFeedbackTagCommand}"
                                    Background="#0E639C" Foreground="White" CornerRadius="4" Padding="6,2" FontSize="11" FontWeight="SemiBold"
                                    ToolTip.Tip="Выбрать тег концевика открытого положения (SQH) из базы" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding AvailableConnections}" 
                                  SelectedItem="{Binding FeedbackConnectionId}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Как у основного или выберите..." />
                        <TextBox Text="{Binding FeedbackAddress}" PlaceholderText="напр. 10016 или 40002" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Концевик «Закрыт» (SQL / Closed Feedback)" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="🏷️ Выбрать..." Command="{Binding BrowseClosedFeedbackTagCommand}"
                                    Background="#0E639C" Foreground="White" CornerRadius="4" Padding="6,2" FontSize="11" FontWeight="SemiBold"
                                    ToolTip.Tip="Выбрать тег концевика закрытого положения (SQL) из базы" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding AvailableConnections}" 
                                  SelectedItem="{Binding ClosedFeedbackConnectionId}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Как у основного или выберите..." />
                        <TextBox Text="{Binding ClosedFeedbackAddress}" PlaceholderText="напр. 10017" />

                        <TextBlock Text="Допустимое рассогласование (%)" Foreground="#AAAAAA" FontSize="11" Margin="0,4,0,0" />
                        <NumericUpDown Value="{Binding Tolerance}" Minimum="0" Maximum="100" FormatString="0.0 '%'" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Тэг режима управления (Ручной / Авто)" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="🏷️ Выбрать..." Command="{Binding BrowseModeTagCommand}"
                                    Background="#0E639C" Foreground="White" CornerRadius="4" Padding="6,2" FontSize="11" FontWeight="SemiBold"
                                    ToolTip.Tip="Выбрать тег режима управления (ручной/авто) из базы" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding AvailableConnections}" 
                                  SelectedItem="{Binding ModeConnectionId}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Как у основного или выберите..." />
                        <TextBox Text="{Binding ModeAddress}" PlaceholderText="напр. 40003 или valve/mode" />

                        <TextBlock Text="Размеры диалогового окна управления" Foreground="#00AAFF" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ширина (px)" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding ControlWindowWidth}" Minimum="200" Maximum="800" FormatString="0 px" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Высота (px)" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding ControlWindowHeight}" Minimum="200" Maximum="600" FormatString="0 px" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Pump Production & VFD Settings -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4"
                        IsVisible="{Binding ShowPumpSettings}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Настройки насоса и ПЧ (VFD)" Foreground="#38BDF8" FontSize="14" FontWeight="SemiBold" />

                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Режим управления насосом" Foreground="#AAAAAA" FontSize="11" />
                                <ComboBox ItemsSource="{Binding AvailablePumpControlModes}" SelectedItem="{Binding SelectedPumpControlMode}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Поворот патрубка (град)" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding SelectedRotation}" Minimum="0" Maximum="270" Increment="90" FormatString="0°" />
                            </StackPanel>
                        </Grid>

                        <!-- ModeSource & FeedbackSource -->
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Тег режима Ручной/Авто (ModeSource)" Foreground="#AAAAAA" FontSize="11" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ModeAddress}" PlaceholderText="Адрес..." />
                                    <Button Grid.Column="1" Command="{Binding BrowseModeTagCommand}" Content="🏷️" Margin="4,0,0,0" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4" IsVisible="{Binding IsPumpFeedbackMode}">
                                <TextBlock Text="Тег обратной связи (FeedbackSource)" Foreground="#AAAAAA" FontSize="11" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding FeedbackAddress}" PlaceholderText="Адрес ОС..." />
                                    <Button Grid.Column="1" Command="{Binding BrowseFeedbackTagCommand}" Content="🏷️" Margin="4,0,0,0" ToolTip.Tip="Выбрать тег обратной связи из базы" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Combined VFD Tags & Bounds -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsPumpVfdMode}">
                            <Separator Background="#3E3E42" />
                            <TextBlock Text="Каналы преобразователя частоты (ПЧ)" Foreground="#9CDCFE" FontSize="12" FontWeight="SemiBold" />

                            <Grid ColumnDefinitions="*,10,*">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Уставка частоты (SetpointSource)" Foreground="#AAAAAA" FontSize="11" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding PumpSetpointAddress}" PlaceholderText="Адрес уставки..." />
                                        <Button Grid.Column="1" Command="{Binding BrowsePumpSetpointTagCommand}" Content="🏷️" Margin="4,0,0,0" ToolTip.Tip="Выбрать тег уставки частоты из базы" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="ОС частоты (FrequencyFeedback)" Foreground="#AAAAAA" FontSize="11" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding PumpFreqFeedbackAddress}" PlaceholderText="Адрес частоты..." />
                                        <Button Grid.Column="1" Command="{Binding BrowsePumpFreqFeedbackTagCommand}" Content="🏷️" Margin="4,0,0,0" ToolTip.Tip="Выбрать тег обратной связи частоты из базы" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,10,*">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="ОС тока (CurrentFeedback)" Foreground="#AAAAAA" FontSize="11" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding PumpCurrentFeedbackAddress}" PlaceholderText="Адрес тока..." />
                                        <Button Grid.Column="1" Command="{Binding BrowsePumpCurrentFeedbackTagCommand}" Content="🏷️" Margin="4,0,0,0" ToolTip.Tip="Выбрать тег обратной связи тока из базы" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Слово состояния (StatusWord)" Foreground="#AAAAAA" FontSize="11" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding PumpStatusWordAddress}" PlaceholderText="Адрес StatusWord..." />
                                        <Button Grid.Column="1" Command="{Binding BrowsePumpStatusWordTagCommand}" Content="🏷️" Margin="4,0,0,0" ToolTip.Tip="Выбрать тег слова состояния из базы" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Ед. измерения" Foreground="#AAAAAA" FontSize="11" />
                                    <ComboBox ItemsSource="{Binding AvailableFrequencyUnits}" SelectedItem="{Binding PumpFrequencyUnit}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Мин. частота" Foreground="#AAAAAA" FontSize="11" />
                                    <NumericUpDown Value="{Binding PumpMinFrequency}" Minimum="0" Maximum="100" Increment="1" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Макс. частота" Foreground="#AAAAAA" FontSize="11" />
                                    <NumericUpDown Value="{Binding PumpMaxFrequency}" Minimum="1" Maximum="400" Increment="5" />
                                </StackPanel>
                            </Grid>

                            <!-- StatusWord Bitmask Editor -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0" Text="Таблица битов StatusWord" Foreground="#FFD700" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding AddStatusBitMappingCommand}" Content="+ Добавить бит" Padding="8,3" FontSize="11" Background="#007ACC" Foreground="White" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding PumpStatusWordMap}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StatusBitMappingItem">
                                        <Grid ColumnDefinitions="105,*,110,Auto" ColumnSpacing="6" Margin="0,2">
                                            <NumericUpDown Grid.Column="0" Value="{Binding BitIndex}" Minimum="0" Maximum="15" FormatString="0" />
                                            <TextBox Grid.Column="1" Text="{Binding Text}" PlaceholderText="Текст статуса..." />
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding $parent[Window].((vm:WidgetEditorViewModel)DataContext).AvailableStatusSeverities}" SelectedItem="{Binding Severity}" HorizontalAlignment="Stretch" />
                                            <Button Grid.Column="3" Command="{Binding $parent[Window].((vm:WidgetEditorViewModel)DataContext).RemoveStatusBitMappingCommand}" CommandParameter="{Binding}" Content="🗑" Padding="6,4" Background="#442222" Foreground="#FF6666" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Reactor Production Settings -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4"
                        IsVisible="{Binding ShowReactorSettings}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Настройки реактора и мешалки" Foreground="#00AAFF" FontSize="14" FontWeight="SemiBold" />
                        <CheckBox Content="Отображать рубашку обогрева/охлаждения" IsChecked="{Binding ReactorHasJacket}" Foreground="LightGray" />

                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Команда мешалки (AgitatorSource)" Foreground="#AAAAAA" FontSize="11" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ReactorAgitatorAddress}" PlaceholderText="Адрес пуска мешалки..." />
                                    <Button Grid.Column="1" Command="{Binding BrowseReactorAgitatorTagCommand}" Content="🏷️" Margin="4,0,0,0" ToolTip.Tip="Выбрать тег мешалки" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="ОС мешалки (AgitatorFeedback)" Foreground="#AAAAAA" FontSize="11" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ReactorAgitatorFeedbackAddress}" PlaceholderText="Адрес ОС мешалки..." />
                                    <Button Grid.Column="1" Command="{Binding BrowseReactorAgitatorFeedbackTagCommand}" Content="🏷️" Margin="4,0,0,0" ToolTip.Tip="Выбрать тег ОС мешалки" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Температура (TempSource)" Foreground="#AAAAAA" FontSize="11" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ReactorTempAddress}" PlaceholderText="Адрес температуры..." />
                                    <Button Grid.Column="1" Command="{Binding BrowseReactorTempTagCommand}" Content="🏷️" Margin="4,0,0,0" ToolTip.Tip="Выбрать тег температуры" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Уставка температуры (TempSetpoint)" Foreground="#AAAAAA" FontSize="11" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ReactorTempSetpointAddress}" PlaceholderText="Адрес уставки..." />
                                    <Button Grid.Column="1" Command="{Binding BrowseReactorTempSetpointTagCommand}" Content="🏷️" Margin="4,0,0,0" ToolTip.Tip="Выбрать тег уставки" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Режим Ручной/Авто (ModeSource)" Foreground="#AAAAAA" FontSize="11" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding ModeAddress}" PlaceholderText="Адрес режима (0=Ручн, 1=Авто)..." />
                                <Button Grid.Column="1" Command="{Binding BrowseModeTagCommand}" Content="🏷️" Margin="4,0,0,0" ToolTip.Tip="Выбрать тег режима" />
                            </Grid>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,8,*,8,*">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Мин. T (°C)" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding ReactorMinTemp}" Minimum="-100" Maximum="1000" Increment="5" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="Макс. T (°C)" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding ReactorMaxTemp}" Minimum="-100" Maximum="1000" Increment="5" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="2">
                                <TextBlock Text="Авария T (°C)" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding ReactorHighTempAlarm}" Minimum="-100" Maximum="1000" Increment="5" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Верхний уровень аварии" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding ReactorHighLevelAlarm}" Minimum="0" Maximum="10000" Increment="5" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="Нижний уровень аварии" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding ReactorLowLevelAlarm}" Minimum="0" Maximum="10000" Increment="5" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Industrial Color Settings -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4"
                        IsVisible="{Binding ShowIndustrialSettings}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Цветовое кодирование мнемосхемы" Foreground="#FFD700" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Цвет «Активно / Открыто / Поток»" Foreground="#AAAAAA" FontSize="11" />
                                <scada:ColorPickerBox SelectedColorHex="{Binding ActiveColor}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Цвет «Неактивно / Закрыто / Стоп»" Foreground="#AAAAAA" FontSize="11" />
                                <scada:ColorPickerBox SelectedColorHex="{Binding InactiveColor}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Container Settings -->
                <Border Background="#2D2D30" CornerRadius="6" Padding="12" Margin="0,4"
                        IsVisible="{Binding ShowContainerSettings}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Параметры контейнера подэкрана" Foreground="#00AAFF" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Размер сетки контейнера (px)" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding ContainerCellSize}" Minimum="10" Maximum="500" Increment="5" FormatString="0 px" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Масштаб контейнера (%)" Foreground="#AAAAAA" FontSize="11" />
                                <NumericUpDown Value="{Binding ContainerZoomPercent}" Minimum="20" Maximum="300" Increment="5" FormatString="0 '%'" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Fixed bottom button bar -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid ColumnDefinitions="*,12,*">
                <Button Grid.Column="0" 
                        Content="❌  Отмена" 
                        IsCancel="True"
                        Command="{Binding CancelCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#3E3E42" Foreground="White" CornerRadius="6" 
                        Padding="12,10" FontSize="14" />
                <Button Grid.Column="2" 
                        Content="💾  Применить" 
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#007ACC" Foreground="White" CornerRadius="6" 
                        Padding="12,10" FontSize="14" FontWeight="SemiBold" />
            </Grid>
        </Border>

    </Grid>
</Window>
