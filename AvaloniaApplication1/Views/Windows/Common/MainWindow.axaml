<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels.Windows.Common"
        xmlns:vmCore="clr-namespace:AvaloniaApplication1.ViewModels.Core"
        xmlns:vmPanels="clr-namespace:AvaloniaApplication1.ViewModels.Panels"
        xmlns:vmPopups="clr-namespace:AvaloniaApplication1.ViewModels.Popups"
        xmlns:vPanels="clr-namespace:AvaloniaApplication1.Views.Panels"
        xmlns:vPopups="clr-namespace:AvaloniaApplication1.Views.Popups"
        xmlns:c="clr-namespace:AvaloniaApplication1.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaApplication1.Views.Windows.Common.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app_icon.png"
        Width="1400" Height="900"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <Window.Resources>
        <c:BoolToBrushConverter x:Key="BoolToColor" TrueBrush="#E51400" FalseBrush="#0050EF" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.header-tab">
            <Setter Property="Background" Value="{DynamicResource ThemeTabInactiveBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeMutedTextBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.header-tab.active">
            <Setter Property="Background" Value="{DynamicResource ThemeTabActiveBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="F10" Command="{Binding OpenCalculatorCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ToggleDesignModeCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveConfigCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveConfigAsCommand}" />
        <KeyBinding Gesture="Ctrl+T" Command="{Binding OpenTagManagerCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding Dashboard.UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding Dashboard.RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding Dashboard.RedoCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Row 0: Top Header Status & Navigation Bar (Always Visible) -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBrush}" Padding="10,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left Section: Title, Windows Count, Tabs (in Design) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="HMI SCADA" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding ActiveChildWindows.Count, StringFormat='[{0}]'}" Foreground="#FF5252" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" ToolTip.Tip="Количество открытых окон" />
                    
                    <!-- Dashboard tab visible in Design mode -->
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource ThemeSeparatorBrush}" Margin="4,0" IsVisible="{Binding ProjectContext.IsDesignMode}" />
                    <Button Command="{Binding ShowDashboardCommand}"
                            Content="📊 Дашборд"
                            Classes="header-tab"
                            Classes.active="{Binding !IsMimicActive}"
                            IsVisible="{Binding ProjectContext.IsDesignMode}" />
                    <Button Command="{Binding ShowMimicCommand}"
                            Content="📐 Мнемосхема"
                            Classes="header-tab"
                            Classes.active="{Binding IsMimicActive}"
                            IsVisible="{Binding ProjectContext.IsDesignMode}" />
                </StackPanel>

                <!-- Center Section: Live Clock, Connection Health & Alarms Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Live Clock & Date Badge -->
                    <Border Background="{DynamicResource ThemeSubtleBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3"
                            ToolTip.Tip="Текущее системное время и дата оператора">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="🕒" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentTimeText}" Foreground="#4EC9B0" FontSize="12" FontWeight="Bold" FontFamily="Consolas, monospace" VerticalAlignment="Center" />
                            <TextBlock Text="|" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentDateText}" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Connection Status Badge (Clickable) -->
                    <Button Command="{Binding OpenConnectionManagerCommand}"
                            Background="{DynamicResource ThemeSubtleBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3"
                            ToolTip.Tip="Статус сетевых драйверов (нажмите для открытия менеджера связей)">
                        <TextBlock Text="{Binding ConnectionStatusText}" Foreground="#DCDCAA" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Button>

                    <!-- Alarms Counter Badge -->
                    <Border Background="{DynamicResource ThemeSubtleBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3"
                            ToolTip.Tip="Сводка активных аварийных сигналов технологического процесса">
                        <TextBlock Text="{Binding ActiveAlarmsText}" Foreground="#9CDCFE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Right Section: Current Config Badge, Theme Switch, Calculator, Mode Switch -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Active Project Name Badge (ALWAYS VISIBLE) -->
                    <Border Background="{DynamicResource ThemeSubtleBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Текущий активный файл конфигурации проекта">
                        <TextBlock Text="{Binding CurrentProjectName, StringFormat='📁 {0}'}" 
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>

                    <!-- Theme Toggle Button (ALWAYS VISIBLE) -->
                    <Button Command="{Binding ToggleThemeCommand}"
                            Content="{Binding ThemeToggleGlyph}"
                            Background="{DynamicResource ThemeSubtleBrush}"
                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4" Padding="8,4"
                            ToolTip.Tip="Сменить тему оформления (Темная / Светлая / Промышленный серый ISA-101)" />

                    <!-- Calculator Button (ALWAYS VISIBLE) -->
                    <Button Command="{Binding OpenCalculatorCommand}"
                            Content="🧮"
                            Background="{DynamicResource ThemeSubtleBrush}"
                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1"
                            Foreground="#00E5FF" CornerRadius="4" Padding="8,4"
                            ToolTip.Tip="Открыть технологический калькулятор и пересчет величин (F10)" />

                    <!-- Mode Toggle Button (ALWAYS VISIBLE) -->
                    <Button Command="{Binding ToggleDesignModeCommand}" 
                            Background="{Binding ProjectContext.IsDesignMode, Converter={StaticResource BoolToColor}}" 
                            Foreground="White" CornerRadius="4" Padding="10,4"
                            ToolTip.Tip="Переключить режим редактирования (Ctrl+E)">
                        <Button.Content>
                            <Binding Path="ProjectContext.IsDesignMode">
                                <Binding.Converter>
                                    <c:BoolToStringConverter TrueString="🔒 Runtime (Ctrl+E)" FalseString="✏️ Design (Ctrl+E)" />
                                </Binding.Converter>
                            </Binding>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Dedicated Design Mode Engineering Toolbar (Visible only in Design Mode) -->
        <Border Grid.Row="1" 
                Background="{DynamicResource ThemeToolbarBrush}" 
                BorderBrush="{DynamicResource ThemeBorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="10,4"
                IsVisible="{Binding ProjectContext.IsDesignMode}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Group 1: Project File Operations -->
                    <TextBlock Text="Проект:" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0" />
                    <Button Command="{Binding OpenProjectCommand}"
                            Content="📂 Загрузить..."
                            Background="#0E639C"
                            Foreground="White" CornerRadius="4" Padding="8,4" FontSize="12"
                            ToolTip.Tip="Загрузить проект из файла JSON (Ctrl+O)" />
                    <Button Command="{Binding SaveConfigCommand}"
                            Content="💾 Сохранить"
                            Background="#008A00"
                            Foreground="White" CornerRadius="4" Padding="8,4" FontSize="12"
                            ToolTip.Tip="Сохранить текущий проект (Ctrl+S)" />
                    <Button Command="{Binding SaveConfigAsCommand}"
                            Content="💾 Как..."
                            Background="#107C41"
                            Foreground="White" CornerRadius="4" Padding="8,4" FontSize="12"
                            ToolTip.Tip="Сохранить проект под новым именем (Ctrl+Shift+S)" />

                    <!-- Vertical Separator -->
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ThemeSeparatorBrush}" Margin="6,0" VerticalAlignment="Center" />

                    <!-- Group 2: Engineering & Signals Subsystems -->
                    <TextBlock Text="Инженерия:" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0" />
                    <Button Command="{Binding OpenTagManagerCommand}"
                            Content="🏷️ База тегов"
                            Background="#D97706"
                            Foreground="White" CornerRadius="4" Padding="8,4" FontSize="12"
                            ToolTip.Tip="Менеджер тегов и база сигналов (Ctrl+T)" />
                    <Button Command="{Binding OpenConnectionManagerCommand}"
                            Content="📡 Менеджер связей"
                            Background="#6A1B9A"
                            Foreground="White" CornerRadius="4" Padding="8,4" FontSize="12"
                            ToolTip.Tip="Менеджер сетевых подключений (Modbus TCP/RTU, MQTT)" />
                    <Button Command="{Binding OpenSettingsCommand}"
                            Content="⚙️ Настройки"
                            Background="{DynamicResource ThemeSubtleBrush}"
                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource ThemeTextPrimaryBrush}" CornerRadius="4" Padding="8,4" FontSize="12"
                            ToolTip.Tip="Настройки проекта, мнемосхемы, темы, симуляции и пароля (Ctrl+,)" />

                    <!-- Vertical Separator -->
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource ThemeSeparatorBrush}" Margin="6,0" VerticalAlignment="Center" />

                    <!-- Group 3: History Operations -->
                    <TextBlock Text="История:" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,4,0" />
                    <Button Command="{Binding Dashboard.UndoCommand}"
                            IsEnabled="{Binding Dashboard.CanUndo}"
                            Content="↶ Отменить"
                            Background="{DynamicResource ThemeSubtleBrush}"
                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource ThemeTextPrimaryBrush}" CornerRadius="4" Padding="8,4" FontSize="12"
                            ToolTip.Tip="Отменить последнее действие (Ctrl+Z)" />
                    <Button Command="{Binding Dashboard.RedoCommand}"
                            IsEnabled="{Binding Dashboard.CanRedo}"
                            Content="↷ Повторить"
                            Background="{DynamicResource ThemeSubtleBrush}"
                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource ThemeTextPrimaryBrush}" CornerRadius="4" Padding="8,4" FontSize="12"
                            ToolTip.Tip="Повторить отмененное действие (Ctrl+Y / Ctrl+Shift+Z)" />
                    <Button Command="{Binding Dashboard.ToggleHistoryPanelCommand}"
                            Content="{Binding Dashboard.HistoryStepsBadgeText}"
                            Background="#1E3A5F"
                            Foreground="#00E5FF" CornerRadius="4" Padding="8,4" FontSize="12"
                            ToolTip.Tip="Открыть боковую панель таймлайна истории изменений" />
                </StackPanel>

                <!-- Right Side Hint / Quick Help in Design Mode -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="💡 Режим редактирования: ЛКМ — выбор/перемещение, ПКМ — контекстное меню" 
                               Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="11" FontStyle="Italic" VerticalAlignment="Center" Margin="0,0,4,0" />
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Row 2: Main Workspace Canvas & Child Windows -->
        <Grid Grid.Row="2">
            <!-- Main Dashboard -->
            <ContentControl Content="{Binding Dashboard}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vmPanels:DashboardViewModel}">
                        <vPanels:DashboardView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <!-- Child Windows Overlay -->
            <ItemsControl ItemsSource="{Binding ActiveChildWindows}" ZIndex="100" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerTheme>
                    <ControlTheme TargetType="ContentPresenter" x:DataType="vmCore:ChildWindowViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        <Setter Property="ZIndex" Value="{Binding ZIndex}" />
                    </ControlTheme>
                </ItemsControl.ItemContainerTheme>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vmCore:ChildWindowViewModel}">
                        <!-- Child Window Frame -->
                        <Border Background="{DynamicResource ThemeSurfaceBrush}" 
                                BorderBrush="{DynamicResource ThemeBorderBrush}" 
                                BorderThickness="2" 
                                CornerRadius="8" 
                                Width="{Binding Width}" 
                                Height="{Binding Height}"
                                BoxShadow="0 8 24 0 #66000000"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Title Bar (Draggable) -->
                                <Grid Grid.Row="0" 
                                      ColumnDefinitions="*,Auto,Auto" 
                                      Background="{DynamicResource ThemeHeaderBrush}" 
                                      Height="36"
                                      PointerPressed="OnTitleBarPointerPressed"
                                      PointerMoved="OnTitleBarPointerMoved"
                                      PointerReleased="OnTitleBarPointerReleased">
                                    
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding Title}" 
                                               Foreground="{DynamicResource ThemeTextPrimaryBrush}" 
                                               FontSize="14" 
                                               FontWeight="Bold" 
                                               VerticalAlignment="Center" 
                                               Margin="12,0" 
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Minimize Button -->
                                    <Button Grid.Column="1" 
                                            Command="{Binding ToggleMinimizeCommand}"
                                            Content="🗕" 
                                            Background="Transparent" 
                                            Foreground="#B0B0B0" 
                                            Width="36" Height="36" 
                                            CornerRadius="0"
                                            VerticalContentAlignment="Center" 
                                            HorizontalContentAlignment="Center"
                                            BorderThickness="0"
                                            ToolTip.Tip="Свернуть окно">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="#505052"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                    
                                    <!-- Close Button -->
                                    <Button Grid.Column="2" 
                                            Command="{Binding CloseCommand}"
                                            Content="✕" 
                                            Background="Transparent" 
                                            Foreground="#B0B0B0" 
                                            Width="36" Height="36" 
                                            CornerRadius="0"
                                            VerticalContentAlignment="Center" 
                                            HorizontalContentAlignment="Center"
                                            BorderThickness="0"
                                            ToolTip.Tip="Закрыть окно">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="#E81123"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Grid>

                                <!-- Panel Content Area -->
                                <Grid Grid.Row="1" Background="{DynamicResource ThemeBackgroundBrush}" IsVisible="{Binding !IsMinimized}">
                                    <ContentControl Content="{Binding Content}">
                                        <ContentControl.DataTemplates>
                                            <DataTemplate DataType="{x:Type vmPanels:DashboardViewModel}">
                                                <vPanels:DashboardView />
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type vmPopups:ValveControlPopupViewModel}">
                                                <vPopups:ValveControlPopupView />
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type vmPopups:PumpFaceplateViewModel}">
                                                <vPopups:PumpFaceplateView />
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type vmPopups:NumpadViewModel}">
                                                <vPopups:NumpadView />
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type vmPopups:CalculatorViewModel}">
                                                <vPopups:CalculatorView />
                                            </DataTemplate>
                                        </ContentControl.DataTemplates>
                                    </ContentControl>

                                    <!-- Bottom-right Resize Handle -->
                                    <Border HorizontalAlignment="Right" 
                                            VerticalAlignment="Bottom" 
                                            Width="16" Height="16" 
                                            Background="Transparent"
                                            Cursor="BottomRightCorner"
                                            PointerPressed="OnResizeHandlePointerPressed"
                                            PointerMoved="OnResizeHandlePointerMoved"
                                            PointerReleased="OnResizeHandlePointerReleased">
                                        <Path Data="M 12 4 L 12 12 L 4 12 Z M 12 8 L 12 12 L 8 12 Z" 
                                              Fill="#66FFFFFF" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Width="8" Height="8"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Global Toast Notification overlay -->
            <Border HorizontalAlignment="Center" 
                    VerticalAlignment="Bottom" 
                    Margin="0,0,0,50" 
                    Background="#C62828" 
                    BorderBrush="#E53935" 
                    BorderThickness="1.5" 
                    CornerRadius="6" 
                    Padding="16,10" 
                    IsVisible="{Binding IsToastVisible}"
                    BoxShadow="0 4 12 0 #88000000"
                    ZIndex="9999"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
