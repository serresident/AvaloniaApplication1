<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels.Windows.Tags"
        xmlns:models="clr-namespace:AvaloniaApplication1.Models"
        mc:Ignorable="d" d:DesignWidth="840" d:DesignHeight="540"
        x:Class="AvaloniaApplication1.Views.Windows.Tags.TagPickerWindow"
        x:DataType="vm:TagPickerViewModel"
        x:CompileBindings="True"
        Title="🏷️ Выбор тега из базы проекта (Tag Picker)"
        Width="860" Height="540"
        MinWidth="650" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Button.header-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.header-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2D2D30" />
        </Style>
        <Style Selector="Button.header-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3E3E42" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

        <!-- Title & Close Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Text="🏷️ Выберите тег из базы TagManager"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Command="{Binding CancelCommand}"
                    Content="✕ Закрыть"
                    Background="{DynamicResource ThemeSubtleBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                    CornerRadius="4" Padding="12,5" FontSize="12" FontWeight="SemiBold"
                    ToolTip.Tip="Закрыть окно выбора тегов (Esc)" />
        </Grid>

        <!-- Search & Filter Bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,180,140,Auto" Margin="0,0,0,10">
            <!-- Search Bar -->
            <TextBox Grid.Column="0"
                     x:Name="SearchBox"
                     Text="{Binding SearchText}"
                     PlaceholderText="🔍 Поиск по ID тега, имени, адресу или типу..."
                     Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeForegroundBrush}"
                     CornerRadius="4" Padding="10,8" Margin="0,0,8,0" />

            <!-- Connection / Driver Filter ComboBox -->
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding AvailableConnectionsFilter}"
                      SelectedItem="{Binding SelectedConnectionFilter}"
                      Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeForegroundBrush}"
                      HorizontalAlignment="Stretch"
                      CornerRadius="4" Margin="0,0,8,0"
                      ToolTip.Tip="Фильтр по подключению/драйверу" />

            <!-- Data Type Filter ComboBox -->
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding AvailableDataTypesFilter}"
                      SelectedItem="{Binding SelectedDataTypeFilter}"
                      Background="{DynamicResource ThemeSurfaceBrush}" Foreground="{DynamicResource ThemeForegroundBrush}"
                      HorizontalAlignment="Stretch"
                      CornerRadius="4" Margin="0,0,8,0"
                      ToolTip.Tip="Фильтр по типу данных" />

            <!-- Reset Filters Button -->
            <Button Grid.Column="3"
                    Command="{Binding ResetFiltersCommand}"
                    Background="{DynamicResource ThemeSubtleBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                    CornerRadius="4" Padding="10,8"
                    Content="✕ Сброс"
                    ToolTip.Tip="Сбросить строку поиска и фильтры" />
        </Grid>

        <!-- Tag Table -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <!-- Column Header -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="4,2">
                    <Grid ColumnDefinitions="150,*,100,95,75,55,80">
                        <Button Grid.Column="0" Classes="header-btn" Command="{Binding SortCommand}" CommandParameter="TagId" Click="OnHeaderClick"
                                ToolTip.Tip="Сортировка по ID тега">
                            <TextBlock Text="{Binding TagIdHeader}" Foreground="#9CDCFE" FontSize="11" FontWeight="Bold" IsHitTestVisible="False" />
                        </Button>
                        <Button Grid.Column="1" Classes="header-btn" Command="{Binding SortCommand}" CommandParameter="Name" Click="OnHeaderClick"
                                ToolTip.Tip="Сортировка по наименованию">
                            <TextBlock Text="{Binding NameHeader}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" FontWeight="Bold" IsHitTestVisible="False" />
                        </Button>
                        <Button Grid.Column="2" Classes="header-btn" Command="{Binding SortCommand}" CommandParameter="ConnId" Click="OnHeaderClick"
                                ToolTip.Tip="Сортировка по драйверу/подключению">
                            <TextBlock Text="{Binding DriverHeader}" Foreground="#4EC9B0" FontSize="11" FontWeight="Bold" IsHitTestVisible="False" />
                        </Button>
                        <Button Grid.Column="3" Classes="header-btn" Command="{Binding SortCommand}" CommandParameter="Address" Click="OnHeaderClick"
                                ToolTip.Tip="Сортировка по адресу">
                            <TextBlock Text="{Binding AddressHeader}" Foreground="#DCDCAA" FontSize="11" FontWeight="Bold" IsHitTestVisible="False" />
                        </Button>
                        <Button Grid.Column="4" Classes="header-btn" Command="{Binding SortCommand}" CommandParameter="DataType" Click="OnHeaderClick"
                                ToolTip.Tip="Сортировка по типу данных">
                            <TextBlock Text="{Binding DataTypeHeader}" Foreground="#C586C0" FontSize="11" FontWeight="Bold" IsHitTestVisible="False" />
                        </Button>
                        <Button Grid.Column="5" Classes="header-btn" Command="{Binding SortCommand}" CommandParameter="Unit" Click="OnHeaderClick"
                                ToolTip.Tip="Сортировка по единицам измерения">
                            <TextBlock Text="{Binding UnitHeader}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11" FontWeight="Bold" IsHitTestVisible="False" />
                        </Button>
                        <Button Grid.Column="6" Classes="header-btn" Command="{Binding SortCommand}" CommandParameter="Scaling" Click="OnHeaderClick"
                                ToolTip.Tip="Сортировка по масштабу Y">
                            <TextBlock Text="{Binding ScalingHeader}" Foreground="#B5CEA8" FontSize="11" FontWeight="Bold" IsHitTestVisible="False" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Virtualized Tag Rows -->
                <ListBox Grid.Row="1"
                         x:Name="TagsListBox"
                         ItemsSource="{Binding FilteredTags}"
                         SelectedItem="{Binding SelectedTag}"
                         Background="Transparent"
                         DoubleTapped="OnRowDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:TagDefinition">
                            <Grid ColumnDefinitions="150,*,100,95,75,55,80" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding TagId}"
                                           FontFamily="Consolas, monospace" Foreground="#9CDCFE" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TagId}"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           Foreground="{DynamicResource ThemeForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <Border Grid.Column="2" Background="#2A3344" CornerRadius="3" Padding="4,1"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding ConnId}" Foreground="#4EC9B0" FontSize="11" />
                                </Border>

                                <TextBlock Grid.Column="3" Text="{Binding Address}"
                                           FontFamily="Consolas, monospace" Foreground="#DCDCAA"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Address}"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <TextBlock Grid.Column="4" Text="{Binding DataType}"
                                           Foreground="#C586C0" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <TextBlock Grid.Column="5" Text="{Binding Unit}"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <TextBlock Grid.Column="6" Text="{Binding ScalingDisplay}"
                                           FontFamily="Consolas, monospace" Foreground="#B5CEA8" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State Placeholder -->
                <StackPanel Grid.Row="1"
                            IsVisible="{Binding HasNoTags}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" Margin="20" IsHitTestVisible="False">
                    <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="Теги не найдены" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Измените поисковый запрос или сбросьте фильтры" Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" Content="Отмена (Esc)"
                    Command="{Binding CancelCommand}"
                    Background="{DynamicResource ThemeSubtleBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                    CornerRadius="6" Padding="16,8" FontSize="13"
                    HorizontalAlignment="Left" />

            <Button Grid.Column="1" Content="✓ Выбрать тег (Enter)"
                    Command="{Binding ConfirmCommand}"
                    Background="#0E639C" Foreground="White"
                    CornerRadius="6" Padding="20,8" FontSize="13" FontWeight="SemiBold"
                    HorizontalAlignment="Right" />
        </Grid>

    </Grid>
</Window>
