<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="420"
        x:Class="AvaloniaApplication1.Views.TagForceWindow"
        x:DataType="vm:TagForceViewModel"
        x:CompileBindings="True"
        Title="⚡ Ручной ввод значения (Force Override)"
        Width="460" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        CanResize="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="⚡ Ручная фиксация значения (Force)"
                   Foreground="#E040FB" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Spacing="10">

            <!-- Warning Notice -->
            <Border Background="#381E48" BorderBrush="#E040FB" BorderThickness="1" CornerRadius="6" Padding="10,8">
                <TextBlock Text="⚠️ Внимание: принудительная фиксация подменяет физические показания датчиков и регистров ПЛК. В мнемосхемах значение будет отмечено маркером [M]."
                           Foreground="#F3E5F5" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
            </Border>

            <!-- Error message if any -->
            <Border Background="#4A1212" BorderBrush="#FF5252" BorderThickness="1" CornerRadius="4" Padding="8,6"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF5252" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>

            <!-- Tag Summary Card -->
            <Border Background="#252526" CornerRadius="6" Padding="10">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Тег (TagId):" Foreground="#888888" FontSize="11" Margin="0,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TagId}" Foreground="#9CDCFE" FontFamily="Consolas, monospace" FontWeight="Bold" Margin="10,2" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Наименование:" Foreground="#888888" FontSize="11" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Name}" Foreground="White" Margin="10,2" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Адрес / Тип:" Foreground="#888888" FontSize="11" Margin="0,2" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,2">
                        <TextBlock Text="{Binding Address}" Foreground="#DCDCAA" FontFamily="Consolas, monospace" FontSize="11" />
                        <TextBlock Text="|" Foreground="#555555" FontSize="11" />
                        <TextBlock Text="{Binding DataType}" Foreground="#C586C0" FontSize="11" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Текущее значение:" Foreground="#888888" FontSize="11" Margin="0,2" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentValueDisplay}" Foreground="#00E5FF" FontFamily="Consolas, monospace" FontWeight="Bold" Margin="10,2" />
                </Grid>
            </Border>

            <!-- Value Input: Bool mode -->
            <StackPanel Spacing="6" IsVisible="{Binding IsBoolType}">
                <TextBlock Text="Зафиксировать дискретное состояние:" Foreground="#AAAAAA" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton Content="TRUE (1) / ВКЛ" IsChecked="{Binding BoolValue}" Foreground="#00E676" FontWeight="SemiBold" />
                    <RadioButton Content="FALSE (0) / ВЫКЛ" IsChecked="{Binding !BoolValue}" Foreground="#FF5252" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>

            <!-- Value Input: Numeric mode -->
            <StackPanel Spacing="6" IsVisible="{Binding !IsBoolType}">
                <TextBlock Text="Задать принудительное значение:" Foreground="#AAAAAA" FontSize="12" />
                <TextBox Text="{Binding InputValue}"
                         FontFamily="Consolas, monospace" FontSize="16" FontWeight="Bold"
                         Background="#2D2D30" Foreground="White" Padding="8" />

                <!-- Presets -->
                <WrapPanel Orientation="Horizontal" Margin="0,4">
                    <Button Content="0" Command="{Binding SetPresetValueCommand}" CommandParameter="0"
                            Background="#3E3E42" Foreground="White" CornerRadius="3" Padding="8,3" Margin="2" FontSize="11" />
                    <Button Content="1" Command="{Binding SetPresetValueCommand}" CommandParameter="1"
                            Background="#3E3E42" Foreground="White" CornerRadius="3" Padding="8,3" Margin="2" FontSize="11" />
                    <Button Content="10" Command="{Binding SetPresetValueCommand}" CommandParameter="10"
                            Background="#3E3E42" Foreground="White" CornerRadius="3" Padding="8,3" Margin="2" FontSize="11" />
                    <Button Content="50" Command="{Binding SetPresetValueCommand}" CommandParameter="50"
                            Background="#3E3E42" Foreground="White" CornerRadius="3" Padding="8,3" Margin="2" FontSize="11" />
                    <Button Content="100" Command="{Binding SetPresetValueCommand}" CommandParameter="100"
                            Background="#3E3E42" Foreground="White" CornerRadius="3" Padding="8,3" Margin="2" FontSize="11" />
                </WrapPanel>
            </StackPanel>

        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Background="#3E3E42" Foreground="White"
                    CornerRadius="6" Padding="16,8" FontSize="13"
                    HorizontalAlignment="Left" />

            <Button Grid.Column="1" Content="⚡ Зафиксировать (Force)"
                    Command="{Binding ConfirmCommand}"
                    Background="#6A1B9A" Foreground="White"
                    CornerRadius="6" Padding="18,8" FontSize="13" FontWeight="SemiBold"
                    HorizontalAlignment="Right" />
        </Grid>

    </Grid>
</Window>
