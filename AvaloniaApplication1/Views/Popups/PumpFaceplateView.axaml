<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels.Popups"
             xmlns:vmWidgets="clr-namespace:AvaloniaApplication1.ViewModels.Widgets"
             xmlns:scada="https://github.com/avaloniaapplication1/controls"
             xmlns:c="clr-namespace:AvaloniaApplication1.Converters"
             x:Class="AvaloniaApplication1.Views.Popups.PumpFaceplateView"
             x:DataType="vm:PumpFaceplateViewModel"
             x:CompileBindings="True"
             MinWidth="340" MaxWidth="420">

    <UserControl.Resources>
        <c:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.mode-btn">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.mode-btn.active">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel Spacing="12">
            <!-- Header: Pump graphic + Status -->
            <Grid ColumnDefinitions="72,*,Auto">
                <scada:PumpControl Grid.Column="0" Width="64" Height="64"
                                   OperationalState="{Binding PumpViewModel.OperationalState}"
                                   IsRunning="{Binding PumpViewModel.IsRunning}"
                                   IsManualMode="{Binding PumpViewModel.IsManualMode}"
                                   IsFault="{Binding PumpViewModel.IsFault}"
                                   HasWarning="{Binding PumpViewModel.HasWarning}"
                                   IsVfdMode="{Binding IsVfdMode}"
                                   FrequencyText="{Binding PumpViewModel.FrequencyText}"
                                   Rotation="{Binding PumpViewModel.Rotation}"
                                   ActiveColor="{Binding PumpViewModel.ActiveColor}"
                                   InactiveColor="{Binding PumpViewModel.InactiveColor}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="3">
                    <TextBlock Text="{Binding PumpViewModel.Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    <TextBlock Text="{Binding PumpViewModel.DisplayValue}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{Binding PumpViewModel.CurrentColor, Converter={StaticResource HexToBrush}}" />
                    <TextBlock Text="{Binding PumpViewModel.ControlMode, StringFormat='Режим: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding CloseCommand}" Content="✕" Width="28" Height="28" VerticalAlignment="Top"
                        Background="Transparent" Foreground="{DynamicResource ThemeMutedTextBrush}" />
            </Grid>

            <!-- Manual / Auto Mode Switch -->
            <Border Background="{DynamicResource ThemeSubtleBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8"
                    IsVisible="{Binding HasModeSource}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="Режим управления:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundBrush}" />
                    <Button Grid.Column="1" Command="{Binding SetManualModeCommand}" Content="РУЧНОЙ [M]" Margin="4,0" Padding="10,5"
                            Classes="mode-btn" Classes.active="{Binding IsManualMode}"
                            FontWeight="SemiBold" FontSize="11" CornerRadius="4" />
                    <Button Grid.Column="2" Command="{Binding SetAutoModeCommand}" Content="АВТО [A]" Padding="10,5"
                            Classes="mode-btn" Classes.active="{Binding !IsManualMode}"
                            FontWeight="SemiBold" FontSize="11" CornerRadius="4" />
                </Grid>
            </Border>

            <!-- Start / Stop Discrete Controls -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Command="{Binding StartPumpCommand}" IsEnabled="{Binding CanOperateManual}"
                        Content="▶ ПУСК" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                        Background="#16A34A" Foreground="White" FontWeight="Bold" CornerRadius="6" />
                <Button Grid.Column="1" Command="{Binding StopPumpCommand}" IsEnabled="{Binding CanOperateManual}"
                        Content="⏹ СТОП" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                        Background="#DC2626" Foreground="White" FontWeight="Bold" CornerRadius="6" />
            </Grid>

            <!-- Combined VFD Section -->
            <StackPanel Spacing="10" IsVisible="{Binding IsVfdMode}">
                <!-- Telemetry Readback -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Background="{DynamicResource ThemeSubtleBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Частота (ОС)" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                            <TextBlock Text="{Binding PumpViewModel.FrequencyText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource ThemeSubtleBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Ток двигателя" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                            <TextBlock Text="{Binding PumpViewModel.CurrentText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Frequency Setpoint -->
                <Border Background="{DynamicResource ThemeSubtleBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Задание частоты:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding FrequencyUnit}" FontSize="11" Foreground="{DynamicResource ThemeMutedTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0" Text="{Binding SetpointInputText, Mode=TwoWay}" IsEnabled="{Binding CanOperateManual}"
                                     Background="{DynamicResource ThemeBackgroundBrush}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                            <Button Grid.Column="1" Command="{Binding ToggleKeypadCommand}" IsEnabled="{Binding CanOperateManual}"
                                    Content="🔢" Padding="8,5" ToolTip.Tip="Цифровая клавиатура" />
                            <Button Grid.Column="2" Command="{Binding ApplySetpointCommand}" IsEnabled="{Binding CanOperateManual}"
                                    Content="✓ Задать" Padding="10,5" Background="{DynamicResource ThemeAccentBrush}" Foreground="White" FontWeight="SemiBold" />
                        </Grid>

                        <!-- Embedded Numeric Keypad -->
                        <Grid IsVisible="{Binding IsKeypadVisible}" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*,*" RowSpacing="4" ColumnSpacing="4" Margin="0,4,0,0">
                            <Button Grid.Row="0" Grid.Column="0" Command="{Binding KeypadDigitCommand}" CommandParameter="7" Content="7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="1" Command="{Binding KeypadDigitCommand}" CommandParameter="8" Content="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="2" Command="{Binding KeypadDigitCommand}" CommandParameter="9" Content="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="3" Command="{Binding KeypadBackspaceCommand}" Content="⌫" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Стереть символ" />

                            <Button Grid.Row="1" Grid.Column="0" Command="{Binding KeypadDigitCommand}" CommandParameter="4" Content="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="1" Command="{Binding KeypadDigitCommand}" CommandParameter="5" Content="5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="2" Command="{Binding KeypadDigitCommand}" CommandParameter="6" Content="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="3" Command="{Binding KeypadClearCommand}" Content="C" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Очистить" />

                            <Button Grid.Row="2" Grid.Column="0" Command="{Binding KeypadDigitCommand}" CommandParameter="1" Content="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="1" Command="{Binding KeypadDigitCommand}" CommandParameter="2" Content="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="2" Command="{Binding KeypadDigitCommand}" CommandParameter="3" Content="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" Command="{Binding KeypadConfirmCommand}" Content="OK" Background="#16A34A" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                            <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Command="{Binding KeypadDigitCommand}" CommandParameter="0" Content="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Row="3" Grid.Column="2" Command="{Binding KeypadDigitCommand}" CommandParameter="." Content="." HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Decoded StatusWord Bitmask -->
                <Border Background="{DynamicResource ThemeSubtleBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Слово состояния ПЧ (StatusWord):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeForegroundBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusWordHex}" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ActiveStatusBits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vmWidgets:DecodedStatusBit">
                                    <Border Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                            BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource ThemeForegroundBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding BitIndex, StringFormat='Bit {0}'}" FontSize="10" Foreground="{DynamicResource ThemeMutedTextBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
