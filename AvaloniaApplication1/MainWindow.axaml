<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels"
        xmlns:v="clr-namespace:AvaloniaApplication1.Views"
        xmlns:c="clr-namespace:AvaloniaApplication1.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaApplication1.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="{Binding WindowTitle}"
        Width="1400" Height="900"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <c:BoolToBrushConverter x:Key="BoolToColor" TrueBrush="#E51400" FalseBrush="#0050EF" />
        <c:BoolToBrushConverter x:Key="DashboardTabColor" TrueBrush="#2D2D30" FalseBrush="#007ACC" />
        <c:BoolToBrushConverter x:Key="MimicTabColor" TrueBrush="#007ACC" FalseBrush="#2D2D30" />
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ToggleDesignModeCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveConfigCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveConfigAsCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#333337" Padding="8,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left Section: Title, Windows Count, Tabs (in Design) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="HMI SCADA" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding ActiveChildWindows.Count, StringFormat='[{0}]'}" Foreground="#FF5252" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" ToolTip.Tip="Количество открытых окон" />
                    
                    <!-- Dashboard tab visible in Design mode -->
                    <Button Command="{Binding ShowDashboardCommand}"
                            Content="📊 Дашборд"
                            Background="{Binding IsMimicActive, Converter={StaticResource DashboardTabColor}}"
                            Foreground="White" CornerRadius="4" Padding="10,4" BorderThickness="0"
                            IsVisible="{Binding ProjectContext.IsDesignMode}" />
                    <Button Command="{Binding ShowMimicCommand}"
                            Content="📐 Мнемосхема"
                            Background="{Binding IsMimicActive, Converter={StaticResource MimicTabColor}}"
                            Foreground="White" CornerRadius="4" Padding="10,4" BorderThickness="0"
                            IsVisible="{Binding ProjectContext.IsDesignMode}" />
                </StackPanel>

                <!-- Right Section: Current Config Badge, Settings & Mode Switch -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Active Project Name Badge (ALWAYS VISIBLE) -->
                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8,3"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Текущий активный файл конфигурации проекта">
                        <TextBlock Text="{Binding CurrentProjectName, StringFormat='📁 {0}'}" 
                                   Foreground="#9CDCFE" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>

                    <!-- Settings Button (Design mode) -->
                    <Button Command="{Binding OpenSettingsCommand}"
                            Content="⚙️ Настройки"
                            Background="#3E3E42"
                            Foreground="White" CornerRadius="4" Padding="8,4"
                            ToolTip.Tip="Настройки проекта, мнемосхемы и пароля"
                            IsVisible="{Binding ProjectContext.IsDesignMode}"/>

                    <!-- Open Project Button (Design mode) -->
                    <Button Command="{Binding OpenProjectCommand}"
                            Content="📂 Загрузить..."
                            Background="#0E639C"
                            Foreground="White" CornerRadius="4" Padding="8,4"
                            ToolTip.Tip="Загрузить проект из файла JSON (Ctrl+O)"
                            IsVisible="{Binding ProjectContext.IsDesignMode}"/>

                    <!-- Save Project Button -->
                    <Button Command="{Binding SaveConfigCommand}"
                            Content="💾 Сохранить"
                            Background="#008A00"
                            Foreground="White" CornerRadius="4" Padding="7,4"
                            ToolTip.Tip="Сохранить текущий проект (Ctrl+S)"
                            IsVisible="{Binding ProjectContext.IsDesignMode}"/>

                    <!-- Save Project As Button -->
                    <Button Command="{Binding SaveConfigAsCommand}"
                            Content="💾 Как..."
                            Background="#107C41"
                            Foreground="White" CornerRadius="4" Padding="7,4"
                            ToolTip.Tip="Сохранить проект под новым именем (Ctrl+Shift+S)"
                            IsVisible="{Binding ProjectContext.IsDesignMode}"/>

                    <!-- Connections Button -->
                    <Button Command="{Binding OpenConnectionManagerCommand}"
                            Content="📡 Связь"
                            Background="#6A1B9A"
                            Foreground="White" CornerRadius="4" Padding="7,4"
                            ToolTip.Tip="Менеджер подключений (Modbus, MQTT)"
                            IsVisible="{Binding ProjectContext.IsDesignMode}"/>

                    <!-- Simulation Controls -->
                    <Button Command="{Binding ToggleSimulationCommand}"
                            Background="{Binding IsSimulationRunning, Converter={StaticResource BoolToColor}}"
                            Foreground="White" CornerRadius="4" Padding="7,4"
                            ToolTip.Tip="Запуск/остановка внутренней симуляции тегов"
                            IsVisible="{Binding ProjectContext.IsDesignMode}">
                        <Button.Content>
                            <Binding Path="IsSimulationRunning">
                                <Binding.Converter>
                                    <c:BoolToStringConverter TrueString="⏹ Стоп" FalseString="▶ Sim" />
                                </Binding.Converter>
                            </Binding>
                        </Button.Content>
                    </Button>
                    <Button Command="{Binding ResetSimulationCommand}"
                            Content="🔄"
                            Background="#5A5A5A"
                            Foreground="White" CornerRadius="4" Padding="6,4"
                            ToolTip.Tip="Сбросить симуляцию к начальным значениям"
                            IsVisible="{Binding ProjectContext.IsDesignMode}"/>

                    <!-- Mode Toggle Button (ALWAYS VISIBLE) -->
                    <Button Command="{Binding ToggleDesignModeCommand}" 
                            Background="{Binding ProjectContext.IsDesignMode, Converter={StaticResource BoolToColor}}" 
                            Foreground="White" CornerRadius="4" Padding="8,4"
                            ToolTip.Tip="Переключить режим редактирования (Ctrl+E)">
                        <Button.Content>
                            <Binding Path="ProjectContext.IsDesignMode">
                                <Binding.Converter>
                                    <c:BoolToStringConverter TrueString="🔒 Runtime (Ctrl+E)" FalseString="✏️ Design (Ctrl+E)" />
                                </Binding.Converter>
                            </Binding>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <Grid Grid.Row="1">
            <!-- Main Dashboard -->
            <ContentControl Content="{Binding Dashboard}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                        <v:DashboardView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>

            <!-- Child Windows Overlay -->
            <ItemsControl ItemsSource="{Binding ActiveChildWindows}" ZIndex="100" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerTheme>
                    <ControlTheme TargetType="ContentPresenter" x:DataType="vm:ChildWindowViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        <Setter Property="ZIndex" Value="{Binding ZIndex}" />
                    </ControlTheme>
                </ItemsControl.ItemContainerTheme>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChildWindowViewModel}">
                        <!-- Child Window Frame -->
                        <Border Background="#2B2B2B" 
                                BorderBrush="#4E4E50" 
                                BorderThickness="2" 
                                CornerRadius="8" 
                                Width="{Binding Width}" 
                                Height="{Binding Height}"
                                BoxShadow="0 8 24 0 #AA000000"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Title Bar (Draggable) -->
                                <Grid Grid.Row="0" 
                                      ColumnDefinitions="*,Auto,Auto" 
                                      Background="#3A3A3C" 
                                      Height="36"
                                      PointerPressed="OnTitleBarPointerPressed"
                                      PointerMoved="OnTitleBarPointerMoved"
                                      PointerReleased="OnTitleBarPointerReleased">
                                    
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding Title}" 
                                               Foreground="White" 
                                               FontSize="14" 
                                               FontWeight="Bold" 
                                               VerticalAlignment="Center" 
                                               Margin="12,0" 
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Minimize Button -->
                                    <Button Grid.Column="1" 
                                            Command="{Binding ToggleMinimizeCommand}"
                                            Content="🗕" 
                                            Background="Transparent" 
                                            Foreground="#B0B0B0" 
                                            Width="36" Height="36" 
                                            CornerRadius="0"
                                            VerticalContentAlignment="Center" 
                                            HorizontalContentAlignment="Center"
                                            BorderThickness="0">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="#505052"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                    
                                    <!-- Close Button -->
                                    <Button Grid.Column="2" 
                                            Command="{Binding CloseCommand}"
                                            Content="✕" 
                                            Background="Transparent" 
                                            Foreground="#B0B0B0" 
                                            Width="36" Height="36" 
                                            CornerRadius="0"
                                            VerticalContentAlignment="Center" 
                                            HorizontalContentAlignment="Center"
                                            BorderThickness="0">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="#E81123"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Grid>

                                <!-- Panel Content Area -->
                                <Grid Grid.Row="1" Background="#1E1E1E" IsVisible="{Binding !IsMinimized}">
                                    <ContentControl Content="{Binding Content}">
                                        <ContentControl.DataTemplates>
                                            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                                                <v:DashboardView />
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type vm:ValveControlPopupViewModel}">
                                                <v:ValveControlPopupView />
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type vm:NumpadViewModel}">
                                                <v:NumpadView />
                                            </DataTemplate>
                                        </ContentControl.DataTemplates>
                                    </ContentControl>

                                    <!-- Bottom-right Resize Handle -->
                                    <Border HorizontalAlignment="Right" 
                                            VerticalAlignment="Bottom" 
                                            Width="16" Height="16" 
                                            Background="Transparent"
                                            Cursor="BottomRightCorner"
                                            PointerPressed="OnResizeHandlePointerPressed"
                                            PointerMoved="OnResizeHandlePointerMoved"
                                            PointerReleased="OnResizeHandlePointerReleased">
                                        <Path Data="M 12 4 L 12 12 L 4 12 Z M 12 8 L 12 12 L 8 12 Z" 
                                              Fill="#66FFFFFF" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Width="8" Height="8"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Global Toast Notification overlay -->
            <Border HorizontalAlignment="Center" 
                    VerticalAlignment="Bottom" 
                    Margin="0,0,0,50" 
                    Background="#C62828" 
                    BorderBrush="#E53935" 
                    BorderThickness="1.5" 
                    CornerRadius="6" 
                    Padding="16,10" 
                    IsVisible="{Binding IsToastVisible}"
                    BoxShadow="0 4 12 0 #88000000"
                    ZIndex="9999"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
