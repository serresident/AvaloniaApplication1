{
  "servers": {
    "avalonia-docs": {
      "type": "http",
      "url": "https://docs-mcp.avaloniaui.net/mcp"
    },
    "binlog-mcp": {
      "type": "stdio",
      "command": "dotnet",
      "args": ["tool", "run", "binlog-mcp"]
    },
    "xamlmcp": {
      "type": "stdio",
      "command": "dotnet",
      "args": ["${env:USERPROFILE}/.gemini/tools/xamlmcp/XamlMcp.Server.dll"]
    }
  }
}
